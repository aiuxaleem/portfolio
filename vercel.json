{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "admin-test": false,
      "feat/*": false,
      "fix/*": false,
      "chore/*": false,
      "content/*": false
    }
  },
  "routes": [
    {
      "src": "^/_astro/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/fonts/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "^/og/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "^/job/?$",
      "missing": [
        {
          "type": "host",
          "value": "(job\\.aiuxaleem\\.com|aiuxaleem-job(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://aiuxaleem-job.vercel.app/"
      }
    },
    {
      "src": "^/job/(.*)$",
      "missing": [
        {
          "type": "host",
          "value": "(job\\.aiuxaleem\\.com|aiuxaleem-job(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://aiuxaleem-job.vercel.app/$1"
      }
    },
    {
      "src": "^/(?!(?:case-studies|work|experience|resume|contact|_astro|fonts|assets|og|api|favicon\\.svg|sitemap\\.xml|robots\\.txt)(?:/|$))(.+)$",
      "has": [
        {
          "type": "host",
          "value": "(job\\.aiuxaleem\\.com|aiuxaleem-job(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://aiuxaleem-portfolio-app.vercel.app/$1"
      }
    },
    {
      "src": "^/clients/?$",
      "missing": [
        {
          "type": "host",
          "value": "(clients\\.aiuxaleem\\.com|aiuxaleem-clients(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://aiuxaleem-clients.vercel.app/"
      }
    },
    {
      "src": "^/clients/(.*)$",
      "missing": [
        {
          "type": "host",
          "value": "(clients\\.aiuxaleem\\.com|aiuxaleem-clients(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://aiuxaleem-clients.vercel.app/$1"
      }
    },
    {
      "src": "^/(?!(?:case-studies|work|resources|ai-tools|about|contact|_astro|fonts|assets|og|api|favicon\\.svg|sitemap\\.xml|robots\\.txt)(?:/|$))(.+)$",
      "has": [
        {
          "type": "host",
          "value": "(clients\\.aiuxaleem\\.com|aiuxaleem-clients(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://aiuxaleem-portfolio-app.vercel.app/$1"
      }
    },
    {
      "src": "^/v2(?:/.*)?$",
      "status": 307,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "(job\\.aiuxaleem\\.com|aiuxaleem-job(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "dest": "/job"
    },
    {
      "src": "^/((?:case-studies|work|experience|resume|contact)(?:/.*)?)$",
      "has": [
        {
          "type": "host",
          "value": "(job\\.aiuxaleem\\.com|aiuxaleem-job(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "dest": "/job/$1"
    },
    {
      "src": "^/(sitemap\\.xml|robots\\.txt)$",
      "has": [
        {
          "type": "host",
          "value": "(job\\.aiuxaleem\\.com|aiuxaleem-job(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "dest": "/job/$1"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "(clients\\.aiuxaleem\\.com|aiuxaleem-clients(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "dest": "/clients"
    },
    {
      "src": "^/((?:case-studies|work|resources|ai-tools|about|contact)(?:/.*)?)$",
      "has": [
        {
          "type": "host",
          "value": "(clients\\.aiuxaleem\\.com|aiuxaleem-clients(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "dest": "/clients/$1"
    },
    {
      "src": "^/(sitemap\\.xml|robots\\.txt)$",
      "has": [
        {
          "type": "host",
          "value": "(clients\\.aiuxaleem\\.com|aiuxaleem-clients(-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "dest": "/clients/$1"
    }
  ]
}
