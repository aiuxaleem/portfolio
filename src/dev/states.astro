                <div><h2 id={`${theme}-st-remove`} class="admin-card-title"><AdminIcon name="discard" />Remove this project<span class="cory-visually-hidden"> ({theme} theme fixture)</span></h2><p class="form-note">It disappears from the site and from this list: its file is deleted from the repository in one commit, and any draft with it. The site rebuilds in about two minutes.</p></div>
                <div><Button variant="secondary" type="button"><AdminIcon name="discard" size={18} slot="icon-left" />Delete…</Button></div>
              </section>
              <div class="admin-savebar"><p class="admin-savebar-note"><span data-unsaved><AdminIcon name="draft" size={14} /><strong>Changes not saved yet.</strong> </span><span>Publish writes this project to the site; it is live in about two minutes.</span></p><div class="admin-actions"><Button variant="secondary" type="button"><AdminIcon name="draft" size={18} slot="icon-left" />Save draft</Button><Button variant="primary" type="button"><AdminIcon name="publish" size={18} slot="icon-left" />Publish</Button></div></div>
            </div>
            <p style={note}>The sign-in page's panel beside the card (hidden under 1024px on the real page; shown here at every width), and the list's Removed status.</p>
            <div class="admin-signin-panel cory-ink" style="display: grid;">
              <span class="admin-brand"><span class="admin-brand-mark" aria-hidden="true"></span><span>AIUXAleem</span></span>
              <div class="admin-signin-intro"><p class="cory-overline">Admin</p><p class="admin-signin-line">Everything on the site, edited in one place.</p><ul class="admin-signin-points"><li><span aria-hidden="true">01</span><span><strong>Drafts save here</strong><span>An edit is kept in the admin until you publish it. The site does not change.</span></span></li><li><span aria-hidden="true">02</span><span><strong>Publish writes to the site</strong><span>Publishing writes the entry into the site's files as one commit. It is live in about two minutes.</span></span></li><li><span aria-hidden="true">03</span><span><strong>Visitor numbers count without cookies</strong><span>Page views by day and the pages people read most, counted by the site itself.</span></span></li></ul></div>
              <p class="admin-signin-caption">Visitors never see this area. It is not linked from the public site.</p>
            </div>
            <div class="form-panel admin-note" role="note" data-tone="info" data-test-branch><AdminIcon name="info" /><div><p>This admin is reading and publishing the branch <bdi>admin-test</bdi>, not the live site.</p></div></div>
            <div class="form-panel admin-note" role="note" data-tone="info"><AdminIcon name="info" /><div><p>The text of this post is a page carried over from the old site and is not edited here.</p></div></div>
            <p class="form-note">Channel: <a class="admin-out-link" href="https://www.youtube.com/@aiuxaleem" target="_blank" rel="noopener"><bdi>https://www.youtube.com/@aiuxaleem</bdi><span class="cory-visually-hidden"> (opens in a new tab)</span><AdminIcon name="view" size={14} /></a></p>
            <div data-lazy-block style="content-visibility: auto; contain-intrinsic-size: auto 900px;"><Publishing plain uid={`${theme}-pub-more`} waiting={[]} recent={pubFull.recent.slice(0, 3)} more={5} /></div>
            <div class="form-panel admin-note" role="note" data-tone="success"><AdminIcon name="ok" /><div><p><strong>Removed.</strong> The project <bdi>check-remove-x1</bdi> is gone from this list; the site is rebuilding and it leaves the site in about two minutes.</p></div></div>
            <p style={note}>A picture card from the Images page, with the small Copy button (44px tall, narrower).</p>
            <ul class="admin-images" style="list-style: none; margin: 0; padding: 0; max-inline-size: 32rem;">
              <li><div class="admin-thumb"><img src="/assets/author-avatar.jpg" alt="" width="320" height="200" loading="lazy" decoding="async" /></div><p class="admin-path"><bdi>a-very-long-file-name-that-wraps-in-its-card<wbr />.jpg</bdi><span class="cory-visually-hidden"> at ../../assets/projects/a-very-long-file-name-that-wraps-in-its-card.jpg</span></p><div><Button variant="secondary" size="sm" type="button"><AdminIcon name="copy" size={16} slot="icon-left" />Copy</Button></div></li>
              <li><div class="admin-thumb"><img src="/assets/author-avatar.jpg" alt="" width="320" height="200" loading="lazy" decoding="async" /></div><p class="admin-path"><bdi>{stress.unbroken.slice(0, 40)}.jpg</bdi><span class="cory-visually-hidden"> at ../../assets/projects/{stress.unbroken.slice(0, 40)}.jpg</span></p><div><Button variant="secondary" size="sm" type="button"><AdminIcon name="copy" size={16} slot="icon-left" />Copy</Button></div></li>
            </ul>
          </div>
            <p style={note}>Error: the numbers could not be read.</p>
            <div data-lazy-block style="content-visibility: auto; contain-intrinsic-size: auto 900px;"><DashboardView plain uid={`${theme}-error`} error="The database did not answer. Nothing is lost: visits are still being recorded if the site itself is up." range={30} ranges={[7, 30, 90]} base="#main" /></div>
          </div>

          <div data-lazy-block style="display: grid; gap: var(--space-4); content-visibility: auto; contain-intrinsic-size: auto 900px;">
            <h2 style={h2}>Content entries</h2>
            <p style={note}>One sample and one stress fixture per collection. Drafts and fixtures never reach a production build. Optional fields that are missing render nothing.</p>
            {content.map(group => (
              <div style="display: grid; gap: var(--space-3);">
                <p class="cory-overline" style="margin: 0;">{group.name} ({group.entries.length})</p>
                <ul style="display: grid; gap: var(--grid-gap); grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));">
                  {group.entries.map(entry => { const d: any = entry.data; const img = imageOf(d); return (
                    <li style="display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); border-radius: var(--radius-xl); background: var(--surface-card); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm);">
                      {img && <div style="aspect-ratio: var(--aspect-case); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface-sunken);"><Image src={img.src} alt={img.alt} width={640} style="inline-size: 100%; block-size: 100%; object-fit: cover; object-position: top center;" /></div>}
                      <div><span data-badge class="ui-badge">{kind(d)}</span></div>
                      <p style="margin: 0; font-size: var(--text-h4); font-weight: var(--weight-bold); line-height: var(--leading-heading); color: var(--text-strong);">{titleOf(d)}</p>
                      {(d.summary || d.lead || d.description || d.excerpt || d.issuer) && <p style="margin: 0; font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-muted);">{d.summary || d.lead || d.description || d.excerpt || d.issuer}</p>}
                      {d.tags?.length > 0 && <ul style="display: flex; flex-wrap: wrap; gap: var(--space-2);">{d.tags.map((t: string) => <li><span data-badge class="ui-badge">{t}</span></li>)}</ul>}
                      {d.updates?.length > 0 && <ol style="display: grid; gap: var(--space-2);">{d.updates.map((u: any) => <li style="font-size: var(--text-body-sm); color: var(--text-body);"><span style="font-family: var(--font-mono); font-size: var(--text-mono-sm); color: var(--text-subtle);">{u.date.toISOString().slice(0, 10)}</span> {u.title}</li>)}</ol>}
                      {Object.values(d).some(isPlaceholder) && <p style="margin: 0; font-size: var(--text-caption); color: var(--text-warning);">Contains a placeholder that must be resolved before this can be published.</p>}
                    </li>
                  ); })}
                </ul>
              </div>
            ))}
          </div>

        </div>)}
      </section>
    ))}
  </main>
