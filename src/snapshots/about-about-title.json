body-md); font-weight: var(--weight-semibold); line-height: var(--leading-snug); color: var(--text-strong);\">B.Tech (IT), a STEM degree</dd></div>\n      <div style=\"display: grid; gap: var(--space-1); padding-block: var(--space-4); min-inline-size: 0px;\"><dt style=\"font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle);\">Experience</dt><dd style=\"margin: 0px; font-size: var(--text-body-md); font-weight: var(--weight-semibold); line-height: var(--leading-snug); color: var(--text-strong);\">13+ years, enterprise UX to AI products</dd></div>\n      <div style=\"display: grid; gap: var(--space-1); padding-block: var(--space-4); min-inline-size: 0px;\"><dt style=\"font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle);\">Open to</dt><dd style=\"margin: 0px;\"><span style=\"display: inline-flex; align-items: baseline; gap: var(--space-2); font-size: var(--text-body-md); font-weight: var(--weight-semibold); line-height: var(--leading-snug); color: var(--text-strong);\"><span aria-hidden=\"true\" style=\"inline-size: var(--space-2); block-size: var(--space-2); flex-shrink: 0; border-radius: var(--radius-pill); background: var(--accent-mint);\"></span><span>Senior roles in KSA / UAE, on-site or remote · client work</span></span></dd></div>\n    </dl>\n    </div>\n  </section>",
