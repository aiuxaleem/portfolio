rget); padding-inline: var(--space-2); font-size: var(--text-body-sm); font-weight: var(--weight-medium); color: var(--text-body); text-decoration: none; transition: color var(--duration-base) var(--ease-out);\"><span class=\"sc-interp\">About</span></a></li>\n      </ul>\n    </nav>\n    <div style=\"display: flex; align-items: center; gap: var(--space-2); flex-shrink: 0;\">\n      <div role=\"group\" aria-label=\"Display settings\" style=\"display: flex; align-items: center; gap: var(--space-1); padding: var(--space-1); border-radius: var(--radius-pill); border: 1px solid var(--border-subtle); background: var(--surface-card);\">\n        <div class=\"sc-host-x\" style=\"display: contents;\"><button type=\"button\" aria-label=\"Switch to dark theme\" title=\"Dark theme\" style=\"display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-pill); cursor: pointer; font-size: 20px; line-height: 1; padding: 0px; transition: background var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out), filter var(--duration-base) var(--ease-out); transform: none; background: transparent; color: var(--text-body); border: 1px solid transparent;\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\"></path></svg></button></div>\n        <button type=\"button\" title=\"English only. Opens the closest Arabic page.\" class=\"scp4\" style=\"min-inline-size: var(--tap-target); min-block-size: var(--tap-target); display: inline-flex; align-items: center; justify-content: center; gap: var(--space-1); padding-inline: var(--space-3); border-radius: var(--radius-pill); border: 0px; background: transparent; color: var(--text-link); font-weight: var(--weight-semibold); font-size: var(--text-ui-sm); cursor: pointer; transition: background var(--duration-base) var(--ease-out);\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18\"></path></svg><span lang=\"ar\"><span class=\"sc-interp\">العربية</span></span><span class=\"cory-visually-hidden\"><span class=\"sc-interp\"> (this page is English only, so this opens the closest Arabic page)</span></span></button>\n      </div>\n      <span data-hdr-talk=\"\"><div class=\"sc-host-x\" style=\"display: contents;\"><a href=\"AIUXAleem Home.dc.html#contact\" style=\"position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 8px; padding: 11px 22px; min-height: 44px; font-size: var(--text-ui); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--gradient-brand-deep); color: var(--text-on-brand); box-shadow: var(--shadow-brand); border: 1px solid transparent;\" data-ds-button=\"primary\"><span style=\"display: inline-flex; align-items: center; gap: 8px; visibility: visible;\"><span class=\"sc-interp\">Let's talk</span></span></a></div></span>\n      <span data-hdr-mobile=\"\"><div class=\"sc-host-x\" style=\"display: contents;\"><button type=\"button\" aria-label=\"Open menu\" title=\"Open menu\" aria-expanded=\"false\" style=\"display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-pill); cursor: pointer; font-size: 20px; line-height: 1; padding: 0px; transition: background var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out), filter var(--duration-base) var(--ease-out); transform: none; background: var(--surface-card); color: var(--text-strong); border: 1px solid var(--border-interactive); box-shadow: var(--shadow-xs);\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"></path></svg></button></div></span>\n    </div>\n  </div></header>",
 "extras": "<div aria-hidden=\"true\" style=\"position: fixed; inset-block-start: var(--header-height); inset-inline: 0px; block-size: var(--space-1); z-index: var(--z-sticky); pointer-events: none;\"><div data-progress=\"\" style=\"inline-size: 100%; block-size: 100%; background: var(--gradient-brand); transform: scaleX(0); transform-origin: var(--origin-inline-start) center;\"></div></div>",
 "main": "<main data-v2=\"\" id=\"main\" data-page=\"guide\" tabindex=\"-1\" style=\"position: relative; z-index: var(--z-raised); outline: none; padding-block-start: var(--header-height);\">\n  <article data-article=\"\" data-bg=\"grid\" style=\"padding-block: clamp(var(--space-12), 8vw, var(--space-20)) var(--section-y);\">\n    <header class=\"cory-container cory-container-narrow\" style=\"display: grid; gap: var(--space-5); padding-block-end: var(--space-10); border-block-end: 1px solid var(--border-default);\">\n      <a data-link=\"\" data-hero-el=\"\" href=\"Guides.dc.html\" style=\"display: inline-flex; align-items: center; gap: var(--space-1); justify-self: start; white-space: nowrap; min-block-size: var(--tap-target); font-size: var(--text-body-sm); font-weight: var(--weight-semibold); color: var(--text-link); text-decoration: none;\"><svg data-dir-icon=\"\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 12H5M12 19l-7-7 7-7\"></path></svg> All guides</a>\n      <div data-hero-el=\"\" style=\"display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap;\">\n        <div class=\"sc-host-x\" style=\"display: contents;\"><span style=\"display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; font-size: var(--text-caption); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1.2; border-radius: var(--radius-pill); background: var(--blue-100); color: var(--blue-700); white-space: nowrap;\" data-badge=\"\">Design systems</span></div>\n        <span style=\"font-family: var(--font-mono); font-size: var(--text-caption); color: var(--text-muted);\">9 min read · Updated Sep 2026</span>\n      </div>\n      <h1 data-hero-title=\"\" style=\"margin: 0px; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-title); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--text-strong); text-wrap: balance; overflow-wrap: anywhere;\">Component spec files: the 8-section template</h1>\n      <p data-hero-el=\"\" style=\"margin: 0px; font-size: var(--text-body-lg); line-height: var(--leading-relaxed); color: var(--text-body); text-wrap: pretty;\">A design system is only as good as the file an engineer, or an AI agent, opens at 11pm. This is the structure I use so that file is the same every time.</p>\n      <div data-hero-el=\"\" data-hero-ctas=\"\" style=\"display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;\">\n        <div class=\"sc-host-x\" style=\"display: contents;\"><a href=\"/component-spec-template.md\" download=\"component-spec-template.md\" style=\"position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; min-height: 52px; font-size: var(--text-ui-lg); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--gradient-brand-deep); color: var(--text-on-brand); box-shadow: var(--shadow-brand); border: 1px solid transparent;\" data-ds-button=\"primary\"><span style=\"display: inline-flex; align-items: center; gap: 10px; visibility: visible;\">Download the template (.md)</span></a></div>\n        <a data-link=\"\" href=\"Services.dc.html#offer-ds\" style=\"display: inline-flex; align-items: center; gap: var(--space-1); min-block-size: var(--tap-target); padding-inline: var(--space-2); font-size: var(--text-body-md); font-weight: var(--weight-semibold); color: var(--text-link); text-decoration: none;\">Need it built? See the service <svg data-dir-icon=\"\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"></path></svg></a>\n      </div>\n      <div data-hero-el=\"\" style=\"display: flex; align-items: center; gap: var(--space-3);\">\n        <div class=\"sc-host-x\" style=\"display: contents;\"><img src=\"/assets/author-avatar.jpg\" alt=\"Mohammad Abdul Aleem\" style=\"width: 40px; height: 40px; border-radius: var(--radius-tile); flex-shrink: 0; overflow: hidden; display: inline-flex; box-shadow: none; object-fit: cover;\" width=\"176\" height=\"176\"></div>\n        <span style=\"display: grid; line-height: var(--leading-heading);\"><span style=\"font-size: var(--text-body-sm); font-weight: var(--weight-bold); color: var(--text-strong);\">Mohammad Abdul Aleem</span><span style=\"font-size: var(--text-caption); color: var(--text-muted);\">AI-first Senior Product Designer</span></span>\n      </div>\n    </header>\n\n    <div class=\"cory-container cory-container-narrow\" style=\"display: grid; gap: var(--space-12); padding-block-start: var(--space-10);\">\n\n      <section data-reveal=\"\" aria-labelledby=\"g-why\" style=\"display: grid; gap: var(--space-4); min-inline-size: 0px;\">\n        <h2 id=\"g-why\" style=\"margin: 0px; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h2); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--text-strong); text-wrap: balance;\">Why a spec file, not a Figma page</h2>\n        <p style=\"margin: 0px; font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--text-body); text-wrap: pretty;\">Figma shows what a component looks like. It doesn't say which token a border reads, what happens on <code style=\"font-family: var(--font-mono); font-size: var(--text-body-sm); padding: 0 var(--space-1); border-radius: var(--radius-xs); background: var(--surface-sunken); color: var(--text-strong);\">disabled</code>, or which other components break when the padding changes. Engineers rebuild from screenshots, AI agents guess, and three months later you have four buttons.</p>\n        <p style=\"margin: 0px; font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--text-body); text-wrap: pretty;\">A spec file is plain Markdown that lives next to the code. It is small enough to read in two minutes and structured enough that a model can be pointed at it and produce on-system UI. On the Colaberry Design System, 20 components share this template; new brands are themes, not rebuilds.</p>\n      </section>\n\n      <section data-reveal=\"\" aria-labelledby=\"g-tiers\" style=\"display: grid; gap: var(--space-4); min-inline-size: 0px;\">\n        <h2 id=\"g-tiers\" style=\"margin: 0px; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h2); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--text-strong); text-wrap: balance;\">Six tiers of files</h2>\n        <p style=\"margin: 0px; font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--text-body); text-wrap: pretty;\">Review foundations first. Get colour and spacing right and every component spec follows.</p>\n        <ol style=\"display: grid; gap: var(--space-2);\">\n          <li style=\"display: grid; grid-template-columns: auto minmax(0px, 1fr); gap: var(--space-3); align-items: baseline; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);\"><span style=\"font-family: var(--font-mono); font-size: var(--text-caption); color: var(--text-link);\">TIER 01</span><span style=\"font-size: var(--text-body-sm); color: var(--text-body);\"><strong style=\"color: var(--text-strong);\">Foundations</strong>, colour, spacing, typography, radius, elevation, motion. The primitives every other file inherits.</span></li>\n          <li style=\"display: grid; grid-template-columns: auto minmax(0px, 1fr); gap: var(--space-3); align-items: baseline; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);\"><span style=\"font-family: var(--font-mono); font-size: var(--text-caption); color: var(--text-link);\">TIER 02</span><span style=\"font-size: var(--text-body-sm); color: var(--text-body);\"><strong style=\"color: var(--text-strong);\">Token reference</strong>, the master map of every CSS variable, grouped primitive → semantic → component.</span></li>\n          <li style=\"display: grid; grid-template-columns: auto minmax(0px, 1fr); gap: var(--space-3); align-items: baseline; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);\"><span style=\"font-family: var(--font-mono); font-size: var(--text-caption); color: var(--text-link);\">TIER 03</span><span style=\"font-size: var(--text-body-sm); color: var(--text-body);\"><strong style=\"color: var(--text-strong);\">Atoms</strong>, button, input, icon-button, badge. One spec each.</span></li>\n          <li style=\"display: grid; grid-template-columns: auto minmax(0px, 1fr); gap: var(--space-3); align-items: baseline; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);\"><span style=\"font-family: var(--font-mono); font-size: var(--text-caption); color: var(--text-link);\">TIER 04</span><span style=\"font-size: var(--text-body-sm); color: var(--text-body);\"><strong style=\"color: var(--text-strong);\">Molecules and organisms</strong>, composed components specific to your product.</span></li>\n          <li style=\"display: grid; grid-template-columns: auto minmax(0px, 1fr); gap: var(--space-3); align-items: baseline; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);\"><span style=\"font-family: var(--font-mono); font-size: var(--text-caption); color: var(--text-link);\">TIER 05</span><span style=\"font-size: var(--text-body-sm); color: var(--text-body);\"><strong style=\"color: var(--text-strong);\">Patterns</strong>, layout rules, content flow and spacing between elements.</span></li>\n          <li style=\"display: grid; grid-template-columns: auto minmax(0px, 1fr); gap: var(--space-3); align-items: baseline; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);\"><span style=\"font-family: var(--font-mono); font-size: var(--text-caption); color: var(--text-link);\">TIER 06</span><span style=\"font-size: var(--text-body-sm); color: var(--text-body);\"><strong style=\"color: var(--text-strong);\">Cross-references</strong>, \"uses\" and \"used by\" links across all files.</span></li>\n        </ol>\n      </section>\n\n      <section data-reveal=\"\" aria-labelledby=\"g-template\" style=\"display: grid; gap: var(--space-4); min-inline-size: 0px;\">\n        <h2 id=\"g-template\" style=\"margin: 0px; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h2); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--text-strong); text-wrap: balance;\">The 8-section template</h2>\n        <p style=\"margin: 0px; font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--text-body); text-wrap: pretty;\">Every spec from <code style=\"font-family: var(--font-mono); font-size: var(--text-body-sm); padding: 0 var(--space-1); border-radius: var(--radius-xs); background: var(--surface-sunken); color: var(--text-strong);\">button.md</code> to <code style=\"font-family: var(--font-mono); font-size: var(--text-body-sm); padding: 0 var(--space-1); border-radius: var(--radius-xs); background: var(--surface-sunken); color: var(--text-strong);\">data-table.md</code> has the same eight headings, in the same order. Readers learn the shape once.</p>\n        <ol style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-3);\">\n          <li style=\"display: grid; gap: var(--space-1); padding: var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); min-inline-size: 0px;\"><span style=\"font-family: var(--font-mono); font-size: var(--text-overline); font-weight: var(--weight-semibold); color: var(--text-link);\">01</span><strong style=\"font-size: var(--text-body-md); color: var(--text-strong);\">Metadata</strong><span style=\"font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\">Name, tier, status, owner, version, last reviewed.</span></li>\n          <li style=\"display: grid; gap: var(--space-1); padding: var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); min-inline-size: 0px;\"><span style=\"font-family: var(--font-mono); font-size: var(--text-overline); font-weight: var(--weight-semibold); color: var(--text-link);\">02</span><strong style=\"font-size: var(--text-body-md); color: var(--text-strong);\">Overview</strong><span style=\"font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\">What it is for, when to use it, when not to.</span></li>\n          <li style=\"display: grid; gap: var(--space-1); padding: var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); min-inline-size: 0px;\"><span style=\"font-family: var(--font-mono); font-size: var(--text-overline); font-weight: var(--weight-semibold); color: var(--text-link);\">03</span><strong style=\"font-size: var(--text-body-md); color: var(--text-strong);\">Anatomy</strong><span style=\"font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\">Named parts, slots and their order.</span></li>\n          <li style=\"display: grid; gap: var(--space-1); padding: var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); min-inline-size: 0px;\"><span style=\"font-family: var(--font-mono); font-size: var(--text-overline); font-weight: var(--weight-semibold); color: var(--text-link);\">04</span><strong style=\"font-size: var(--text-body-md); color: var(--text-strong);\">Tokens</strong><span style=\"font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\">Every variable the component reads, never a raw value.</span></li>\n          <li style=\"display: grid; gap: var(--space-1); padding: var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); min-inline-size: 0px;\"><span style=\"font-family: var(--font-mono); font-size: var(--text-overline); font-weight: var(--weight-semibold); color: var(--text-link);\">05</span><strong style=\"font-size: var(--text-body-md); color: var(--text-strong);\">Props / API</strong><span style=\"font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\">Name, type, default, required, and the design intent behind each.</span></li>\n          <li style=\"display: grid; gap: var(--space-1); padding: var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); min-inline-size: 0px;\"><span style=\"font-family: var(--font-mono); font-size: var(--text-overline); font-weight: var(--weight-semibold); color: var(--text-link);\">06</span><strong style=\"font-size: var(--text-body-md); color: var(--text-strong);\">States</strong><span style=\"font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\">Rest, hover, focus-visible, active, disabled, loading, error, with contrast noted.</span></li>\n          <li style=\"display: grid; gap: var(--space-1); padding: var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); min-inline-size: 0px;\"><span style=\"font-family: var(--font-mono); font-size: var(--text-overline); font-weight: var(--weight-semibold); color: var(--text-link);\">07</span><strong style=\"font-size: var(--text-body-md); color: var(--text-strong);\">Code examples</strong><span style=\"font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\">The three most common compositions, copy-pasteable.</span></li>\n          <li style=\"display: grid; gap: var(--space-1); padding: var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); min-inline-size: 0px;\"><span style=\"font-family: var(--font-mono); font-size: var(--text-overline); font-weight: var(--weight-semibold); color: var(--text-link);\">08</span><strong style=\"font-size: var(--text-body-md); color: var(--text-strong);\">Cross-refs</strong><span style=\"font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\">Uses / used by, so a change shows its blast radius.</span></li>\n        </ol>\n      </section>\n\n      <section data-reveal=\"\" aria-labelledby=\"g-example\" style=\"display: grid; gap: var(--space-4); min-inline-size: 0px;\">\n        <h2 id=\"g-example\" style=\"margin: 0px; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h2); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--text-strong); text-wrap: balance;\">A skeleton you can copy</h2>\n        <figure style=\"margin: 0px; display: grid; gap: var(--space-2); min-inline-size: 0px;\">\n          <pre role=\"region\" aria-label=\"Code example: button.md\" tabindex=\"0\" style=\"margin: 0px; max-inline-size: 100%; padding: var(--space-5) var(--space-6); overflow-x: auto; white-space: pre; background: var(--surface-ink); color: var(--on-ink-body); border: 1px solid var(--on-ink-border); border-radius: var(--radius-lg); font-family: var(--font-mono); font-size: var(--text-body-sm); line-height: var(--leading-relaxed);\"><code># button.md\n\n## 01 Metadata\ntier: atom · status: stable · owner: design-systems · v2.3\n\n## 02 Overview\nPrimary action. One per view. Not for navigation.\n\n## 03 Anatomy\n[icon-left] label [icon-right]\n\n## 04 Tokens\nbackground  --action-primary\nlabel       --text-on-brand\nradius      --radius-pill\nshadow      --shadow-brand\n\n## 05 Props / API\nvariant: primary | ink | secondary | ghost   (default primary)\nsize:    sm | md | lg                        (default md)\n\n## 06 States\nhover → --action-primary-hover · focus-visible → --shadow-focus\ndisabled → opacity 0.5, cursor not-allowed\n\n## 07 Code examples\n&lt;Button variant=\"primary\" size=\"lg\"&gt;Book my demo&lt;/Button&gt;\n\n## 08 Cross-refs\nuses: icon · used by: hero, dialog-footer, form-actions</code></pre>\n          <figcaption style=\"font-family: var(--font-mono); font-size: var(--text-caption); color: var(--text-muted);\">Tokens shown are from the AgentCory system the spec was written for.</figcaption>\n        </figure>\n        <div style=\"display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); flex-wrap: wrap; padding: var(--space-4) var(--space-5); background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-lg);\">\n          <span style=\"font-size: var(--text-body-sm); color: var(--text-body); text-wrap: pretty;\">Blank version of this skeleton, with the token and props tables ready to fill.</span>\n          <div class=\"sc-host-x\" style=\"display: contents;\"><a href=\"/component-spec-template.md\" download=\"component-spec-template.md\" style=\"position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 8px; padding: 11px 22px; min-height: 44px; font-size: var(--text-ui); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--action-ink); color: var(--surface-card); box-shadow: var(--shadow-sm); border: 1px solid transparent;\" data-ds-button=\"ink\"><span style=\"display: inline-flex; align-items: center; gap: 8px; visibility: visible;\">Download the template (.md)</span></a></div>\n        </div>\n      </section>\n\n      <section data-reveal=\"\" aria-labelledby=\"g-agents\" style=\"display: grid; gap: var(--space-4); min-inline-size: 0px;\">\n        <h2 id=\"g-agents\" style=\"margin: 0px; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h2); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--text-strong); text-wrap: balance;\">How AI agents use it</h2>\n        <p style=\"margin: 0px; font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--text-body); text-wrap: pretty;\">Point the model at the token reference and the spec for the component it needs. Because sections 04 and 06 are explicit, the agent has no reason to invent a hex code or skip the focus state. The cross-refs tell it what else to open. In practice this is the difference between \"generate a card\" and a card that passes review.</p>\n      </section>\n\n      <section data-reveal=\"\" aria-labelledby=\"g-checklist\" style=\"display: grid; gap: var(--space-4); min-inline-size: 0px;\">\n        <h2 id=\"g-checklist\" style=\"margin: 0px; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h2); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--text-strong); text-wrap: balance;\">Before you publish a spec</h2>\n        <ul style=\"display: grid; gap: var(--space-2);\">\n          <li style=\"display: flex; gap: var(--space-3); align-items: flex-start; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\"><span aria-hidden=\"true\" style=\"inline-size: var(--space-2); block-size: var(--space-2); margin-block-start: var(--space-2); flex-shrink: 0; border-radius: var(--radius-pill); background: var(--text-subtle);\"></span>Every value in section 04 is a token name, not a number.</li>\n          <li style=\"display: flex; gap: var(--space-3); align-items: flex-start; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\"><span aria-hidden=\"true\" style=\"inline-size: var(--space-2); block-size: var(--space-2); margin-block-start: var(--space-2); flex-shrink: 0; border-radius: var(--radius-pill); background: var(--text-subtle);\"></span>Section 06 lists focus-visible and reduced-motion behaviour, with contrast ratios.</li>\n          <li style=\"display: flex; gap: var(--space-3); align-items: flex-start; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\"><span aria-hidden=\"true\" style=\"inline-size: var(--space-2); block-size: var(--space-2); margin-block-start: var(--space-2); flex-shrink: 0; border-radius: var(--radius-pill); background: var(--text-subtle);\"></span>The code example renders in Storybook without edits.</li>\n          <li style=\"display: flex; gap: var(--space-3); align-items: flex-start; padding: var(--space-3) var(--space-4); background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body);\"><span aria-hidden=\"true\" style=\"inline-size: var(--space-2); block-size: var(--space-2); margin-block-start: var(--space-2); flex-shrink: 0; border-radius: var(--radius-pill); background: var(--text-subtle);\"></span>Cross-refs are reciprocal: if A uses B, B lists A under \"used by\".</li>\n        </ul>\n      </section>\n    </div>\n  </article>\n\n  <section data-contact=\"\" aria-labelledby=\"cta-title\" style=\"padding-block: 0 var(--section-y);\">\n    <div class=\"cory-container\">\n      <div data-reveal=\"\" data-stack=\"\" style=\"position: relative; overflow: hidden; background: var(--gradient-ink); border: 1px solid var(--on-ink-border); border-radius: var(--radius-2xl); padding: clamp(var(--space-8), 5vw, var(--space-12)); display: grid; grid-template-columns: minmax(0px, 1fr) auto; gap: var(--space-8); align-items: center;\">\n        <div aria-hidden=\"true\" style=\"position: absolute; inset-block-end: -40%; inset-inline-end: -5%; inline-size: min(40vw, 420px); aspect-ratio: 1 / 1; border-radius: var(--radius-pill); background: var(--glow-cyan); pointer-events: none;\"></div>\n        <div style=\"position: relative; display: grid; gap: var(--space-3); min-inline-size: 0px;\">\n          <p class=\"cory-overline\" style=\"margin: 0px; color: var(--on-ink-link);\">Need this built?</p>\n          <h2 id=\"cta-title\" style=\"margin: 0px; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-title); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--on-ink-strong); text-wrap: balance; overflow-wrap: anywhere;\">I build design systems with spec files like this one.</h2>\n          <p style=\"margin: 0px; font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--on-ink-body); max-inline-size: var(--measure-lead); text-wrap: pretty;\">Tokens, accessible components and docs your engineers and AI agents can both consume.</p>\n        </div>\n        <div style=\"position: relative; display: grid; gap: var(--space-2); justify-items: start;\"><div class=\"sc-host-x\" style=\"display: contents;\"><a href=\"Services.dc.html#offer-ds\" style=\"position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; min-height: 52px; font-size: var(--text-ui-lg); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--gradient-brand-deep); color: var(--text-on-brand); box-shadow: var(--shadow-brand); border: 1px solid transparent;\" data-ds-button=\"primary\"><span style=\"display: inline-flex; align-items: center; gap: 10px; visibility: visible;\">See the service</span></a></div><span style=\"color: var(--on-ink-body); font-size: var(--text-body-sm);\"><div class=\"sc-host\" data-sc-name=\"Email Copy\"><span style=\"display: inline-flex; align-items: center; gap: var(--space-1); flex-wrap: wrap; color: inherit;\" data-email-copy=\"\" data-copied=\"Copied\" data-fallback=\"Selected. Press Ctrl+C or Cmd+C to copy.\">\n  <a data-email=\"\" data-link=\"\" href=\"mailto:hello@aiuxaleem.com?subject=Scope%3A%20Design%20System%20Build\" lang=\"en\" dir=\"ltr\" style=\"display: inline-flex; align-items: center; min-block-size: var(--tap-target); font-weight: var(--weight-semibold); color: inherit; text-decoration: none; overflow-wrap: anywhere;\"><span class=\"sc-interp\">hello@aiuxaleem.com</span></a>\n  <button type=\"button\" aria-label=\"Copy email address\" title=\"Copy email address\" class=\"scp0 scp1\" style=\"display: inline-grid; place-items: center; inline-size: var(--tap-target); block-size: var(--tap-target); border: 0px; border-radius: var(--radius-pill); background: transparent; color: inherit; cursor: pointer; transition: background var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out);\">\n    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"9\" width=\"11\" height=\"11\" rx=\"2\"></rect><path d=\"M5 15V6a2 2 0 0 1 2-2h9\"></path></svg>\n    \n  </button>\n  <span role=\"status\" aria-live=\"polite\" style=\"font-size: var(--text-caption); color: inherit; opacity: var(--opacity-muted);\"><span class=\"sc-interp\"></span></span></span></div></span></div>\n      </div>\n    </div>\n  </section></main>",
