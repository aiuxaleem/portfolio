 "header": "\n  <a href=\"#main\" class=\"scp2\" style=\"position: fixed; inset-block-start: var(--space-4); inset-inline-start: var(--space-4); z-index: var(--z-toast); padding: var(--space-3) var(--space-5); border-radius: var(--radius-pill); background: var(--action-ink); color: var(--surface-card); font-weight: var(--weight-semibold); font-size: var(--text-body-sm); text-decoration: none; transform: translateY(-200%); transition: transform var(--duration-fast) var(--ease-out);\"><span class=\"sc-interp\">Skip to content</span></a><div aria-hidden=\"true\" style=\"block-size: var(--header-height);\"></div><header data-site-header=\"\" data-shared=\"\" data-fixed=\"true\" style=\"position: fixed; inset-block-start: 0px; inset-inline: 0px; inline-size: 100%; z-index: var(--z-sticky); background: var(--surface-header); backdrop-filter: blur(var(--blur-header)); border-block-end: 1px solid var(--border-subtle);\">\n  <div class=\"cory-container\" style=\"block-size: var(--header-height); display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);\">\n    <a href=\"AIUXAleem Home.dc.html\" aria-label=\"AIUXAleem home\" style=\"display: inline-flex; align-items: center; gap: var(--space-2); min-block-size: var(--tap-target); text-decoration: none; color: var(--text-strong); font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h4); letter-spacing: var(--tracking-tight); flex-shrink: 0;\">\n      <span aria-hidden=\"true\" style=\"inline-size: var(--space-5); block-size: var(--space-5); border-radius: var(--radius-tile); background: var(--gradient-brand); flex-shrink: 0;\"></span>\n      <span lang=\"en\" dir=\"ltr\" style=\"white-space: nowrap;\">AIUXAleem</span>\n    </a>\n    <nav data-hdr-desktop=\"\" aria-label=\"Primary\">\n      <ul style=\"display: flex; gap: var(--space-3); align-items: center;\">\n        <li><a data-nav-link=\"\" href=\"Work.dc.html\" class=\"scp3\" style=\"display: inline-f