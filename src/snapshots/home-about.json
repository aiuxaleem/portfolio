{
 "html": "<section id=\"about\" data-section=\"\" data-manifesto=\"\" data-scene-section=\"\" aria-labelledby=\"about-title\" style=\"padding-block: var(--section-y);\">\n    <div class=\"cory-container cory-split\" style=\"gap: var(--space-12) var(--space-16); align-items: center;\">\n      <div style=\"display: grid; gap: var(--space-6);\">\n        <p data-reveal=\"\" id=\"about-title\" class=\"cory-overline\" style=\"margin: 0px;\"><span class=\"sc-interp\">Point of view</span></p>\n        <h2 data-manifesto-text=\"\" style=\"margin: 0px; max-inline-size: 24ch; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-title); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--text-strong); text-wrap: balance;\"><span data-accent=\"true\" style=\"background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent;\"><span class=\"sc-interp\">AI</span></span><span data-accent=\"false\"><span class=\"sc-interp\"> is fast. </span></span><span data-accent=\"true\" style=\"background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent;\"><span class=\"sc-interp\">Trust</span></span><span data-accent=\"false\"><span class=\"sc-interp\"> is slow. I design the gap</span></span></h2>\n        <dl data-reveal=\"\" style=\"margin: 0px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: var(--space-4) var(--space-6); max-inline-size: var(--measure-body);\">\n          \n            <div style=\"display: grid; gap: var(--space-1); padding-block-start: var(--space-4); border-block-start: 1px solid var(--border-subtle); min-inline-size: 0px;\">\n              <dt style=\"font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle);\"><span class=\"sc-interp\">Based in</span></dt>\n              <dd style=\"margin: 0px; font-size: var(--text-body-md); font-weight: var(--weight-semibold); line-height: var(--leading-snug); color: var(--text-strong);\"><span class=\"sc-interp\">Hyderabad, India</span></dd>\n            </div>\n          \n            <div style=\"display: grid; gap: var(--space-1); padding-block-start: var(--space-4); border-block-start: 1px solid var(--border-subtle); min-inline-size: 0px;\">\n              <dt style=\"font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle);\"><span class=\"sc-interp\">Education</span></dt>\n              <dd style=\"margin: 0px; font-size: var(--text-body-md); font-weight: var(--weight-semibold); line-height: var(--leading-snug); color: var(--text-strong);\"><span class=\"sc-interp\">STEM degree, B.Tech (IT)</span></dd>\n            </div>\n          \n            <div style=\"display: grid; gap: var(--space-1); padding-block-start: var(--space-4); border-block-start: 1px solid var(--border-subtle); min-inline-size: 0px;\">\n              <dt style=\"font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle);\"><span class=\"sc-interp\">Experience</span></dt>\n              <dd style=\"margin: 0px; font-size: var(--text-body-md); font-weight: var(--weight-semibold); line-height: var(--leading-snug); color: var(--text-strong);\"><span class=\"sc-interp\">13+ years, enterprise UX to AI products</span></dd>\n            </div>\n          \n        </dl>\n        <a data-link=\"\" data-reveal=\"\" href=\"About.dc.html\" hreflang=\"en\" style=\"display: inline-flex; align-items: center; gap: var(--space-2); inline-size: fit-content; min-block-size: var(--tap-target); font-size: var(--text-body-md); font-weight: var(--weight-semibold); color: var(--text-link); text-decoration: none;\"><span class=\"sc-interp\">More about me</span><svg data-dir-icon=\"\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5l7 7-7 7\"></path></svg></a>\n      </div>\n      <div data-reveal=\"\" style=\"display: grid; justify-items: center;\">\n        <div data-hero-stage=\"\" data-cq=\"\" style=\"position: relative; inline-size: 100%; max-inline-size: 520px; aspect-ratio: 1 / 1; min-inline-size: 0px;\">\n          <div aria-hidden=\"true\" style=\"position: absolute; inset: 0px; border-radius: 50%; background: repeating-radial-gradient(circle at center, var(--border-default) 0 1px, transparent 1px 11%); mask-image: radial-gradient(circle, rgb(0, 0, 0) 0%, transparent 72%); pointer-events: none;\"></div>\n          <div aria-hidden=\"true\" class=\"cory-glow-drift\" style=\"position: absolute; inset: 12%; border-radius: 50%; background: var(--glow-cyan-strong); pointer-events: none;\"></div>\n          <div style=\"position: absolute; inset-block-start: 10%; inset-inline-start: 21%; inline-size: 58%; aspect-ratio: var(--aspect-portrait); border-radius: var(--radius-2xl); overflow: hidden; background: var(--gradient-ink); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-lg);\"><div data-cover-fallback=\"\" aria-hidden=\"true\" style=\"align-items: center; justify-content: center; padding: 0px;\"><span lang=\"en\" dir=\"ltr\" style=\"font-size: var(--text-metric-lg); max-inline-size: none; color: var(--on-ink-muted);\"><span class=\"sc-interp\">MA</span></span></div><div style=\"position: absolute; inset: 0px;\"><span data-image-box=\"about-portrait\" data-alt=\"Portrait: Mohammad Abdul Aleem\" style=\"display:block;position:relative;inline-size:100%;block-size:100%;aspect-ratio:3/2;overflow:hidden;\"><img src=\"/assets/author-portrait.jpg\" alt=\"Portrait: Mohammad Abdul Aleem\" width=\"836\" height=\"836\" style=\"position:absolute;display:block;max-width:none;left:50%;top:50%;width:100%;height:100%;transform:translate(-50%,-50%);object-fit:cover;\"></span></div></div>\n          <span aria-hidden=\"true\" style=\"position: absolute; inset-block-start: 14%; inset-inline-end: 7%; inline-size: clamp(36px, 10cqi, 52px); block-size: clamp(36px, 10cqi, 52px); display: grid; place-items: center; border-radius: var(--radius-lg); background: var(--gradient-ink); border: 1px solid var(--border-default); color: var(--on-ink-strong); box-shadow: var(--shadow-md);\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"inline-size: 46%; block-size: 46%;\"><path d=\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z\"></path><path d=\"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12\"></path><path d=\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\"></path></svg></span>\n          <span aria-hidden=\"true\" style=\"position: absolute; inset-block-start: 46%; inset-inline-start: 4%; inline-size: clamp(36px, 10cqi, 52px); block-size: clamp(36px, 10cqi, 52px); display: grid; place-items: center; border-radius: var(--radius-lg); background: var(--surface-card); border: 1px solid var(--border-default); color: var(--text-link); box-shadow: var(--shadow-md);\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"inline-size: 46%; block-size: 46%;\"><circle cx=\"16\" cy=\"4\" r=\"1\"></circle><path d=\"m18 19 1-7-6 1\"></path><path d=\"m5 8 3-3 5.5 3-2.36 3.5\"></path><path d=\"M4.24 14.5a5 5 0 0 0 6.88 6\"></path><path d=\"M13.76 17.5a5 5 0 0 0-6.88-6\"></path></svg></span>\n          <span aria-hidden=\"true\" style=\"position: absolute; inset-block-end: 9%; inset-inline-end: 16%; inline-size: clamp(36px, 10cqi, 52px); block-size: clamp(36px, 10cqi, 52px); display: grid; place-items: center; border-radius: var(--radius-lg); background: var(--gradient-brand-deep); border: 1px solid var(--border-default); color: var(--on-ink-strong); box-shadow: var(--shadow-brand);\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"inline-size: 46%; block-size: 46%;\"><path d=\"M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z\"></path><path d=\"M20 3v4M22 5h-4\"></path></svg></span>\n          <span aria-hidden=\"true\" style=\"position: absolute; inset-block-end: 16%; inset-inline-start: 11%; inline-size: clamp(36px, 10cqi, 52px); block-size: clamp(36px, 10cqi, 52px); display: grid; place-items: center; border-radius: var(--radius-lg); background: var(--surface-card); border: 1px solid var(--border-default); color: var(--text-success); box-shadow: var(--shadow-md);\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"inline-size: 46%; block-size: 46%;\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></span>\n        </div>\n      </div>\n    </div>\n  </section>",
