---
import AiField from '../components/layout/ai-field.astro';
import { siteOf, sitePath, SUB_SITES } from '../lib/sites';
import '../styles/global.css';
import { site } from '../content/site';
import fonts from '../styles/fonts.json';
import { ogImageFor, abs, languageAlternates } from '../lib/seo';
/* The motion script's address: islands/motion.ts bundled with GSAP into public/_m/ by scripts/perf/bundle-motion.mjs (before every build and dev start), named in the head below. */
import motion from '../components/islands/motion.json';


interface Props {
  title: string;
  description: string;
  page?: string;
  langs?: string;
  lang?: string;
  dir?: string;
  noindex?: boolean;
  /** Canonical URL override, for a post republished from another site. */
  canonical?: string;
  /** Open Graph type. Pages are 'website'; posts and case studies are 'article'. */
  ogType?: string;
  /** Open Graph image path. Default: the image generated for this page (src/lib/seo.ts). */
  ogImage?: string;
  /** JSON-LD objects for this page. Empty entries are skipped. */
  jsonLd?: (Record<string, unknown> | undefined)[];
  /** The web app manifest, for the admin pages only (a phone can install the admin as an app). Public pages have none. */
  manifest?: string;
}
const { title, description, page = '', langs = 'en', lang = 'en', dir = 'ltr' } = Astro.props;
const noindex = Astro.props.noindex;
/* An audience website (docs/SITES.md): its pages are built under /job or /clients and served at the root of their own host.
   The canonical address is on that host, and a page view is counted under the prefix so the dashboard can tell the
   websites apart. */
const sub = siteOf(Astro.url.pathname);
/* Fonts are self-hosted (src/styles/fonts.css). Only the faces used above the fold are preloaded. */
const preload = [...fonts.preload.latin, ...(lang === 'ar' ? fonts.preload.arabic : [])];
const { ogType = 'website', jsonLd = [], manifest } = Astro.props;
const image = abs(Astro.props.ogImage || await ogImageFor(Astro.url.pathname));
/* The share title drops the site suffix; the site name is its own tag. */
const shareTitle = title.replace(/ · AIUXAleem$/, '');
/* Page view count: first-party, no cookie, sent after the page has loaded. Present only where the /api/hit route exists
   (the Vercel build and dev), never on pages marked noindex. Skipped in the owner's browser and for visitors who ask not
   to be tracked. */
const countVisits = import.meta.env.COUNT_VISITS === '1' && !noindex;
const countScript = "(function(){try{if(navigator.doNotTrack==='1'||navigator.globalPrivacyControl||localStorage.getItem('aiuxaleem-owner')==='1')return;var s=function(){navigator.sendBeacon('/api/hit',JSON.stringify({p:(document.documentElement.dataset.site&&location.pathname.indexOf('/'+document.documentElement.dataset.site)!==0?'/'+document.documentElement.dataset.site+(location.pathname==='/'?'':location.pathname):location.pathname),r:document.referrer}))};if(document.readyState==='complete')s();else addEventListener('load',s,{once:true})}catch(e){}})();";
/* The page-flow script (see the comment at its tag below): pageswap names the picture on the page being left, pagereveal
   the one on the page arriving; the name comes off when the transition ends. The two session flags are read by
   scripts/motion/check.mjs. */
const pageFlowScript = "(function(){var N='cover',F='.project-card',M='.project-card-media img',C='main .project-cover img';function off(){return matchMedia('(prefers-reduced-motion: reduce)').matches||!!document.querySelector('.admin-app,[data-admin-js]')}function path(u){try{return new URL(String(u||''),location.href).pathname.replace(/\\/$/,'')||'/'}catch(e){return ''}}function card(p){if(!p)return null;var a=document.querySelectorAll('main a[href]');for(var i=0;i<a.length;i++){if(path(a[i].href)!==p)continue;var c=a[i].closest(F),img=c&&c.querySelector(M);if(img&&img.getClientRects().length)return img}return null}function keep(k,v){try{sessionStorage.setItem(k,v)}catch(e){}}addEventListener('pageswap',function(e){if(!e.viewTransition||off())return;var to=path(e.activation&&e.activation.entry&&e.activation.entry.url),el=card(to)||document.querySelector(C);if(!el)return;el.style.viewTransitionName=N;keep('motion-cover-swap',to)});addEventListener('pagereveal',function(e){if(!e.viewTransition||off())return;var from=path(self.navigation&&navigation.activation&&navigation.activation.from&&navigation.activation.from.url),el=document.querySelector(C)||card(from);if(!el)return;el.style.viewTransitionName=N;document.documentElement.setAttribute('data-vt-cover','');keep('motion-cover-reveal',location.pathname);e.viewTransition.finished.finally(function(){el.style.viewTransitionName='';document.documentElement.removeAttribute('data-vt-cover')})})})();";
const canonical = Astro.props.canonical || (sub ? SUB_SITES[sub].origin + sitePath(Astro.url.pathname) : new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site));
/* The page's field (layout/ai-field.astro) is behind every public page; the admin and its sign-in keep a plain surface. */
const field = !Astro.url.pathname.startsWith('/admin');
---
<!doctype html>
<html lang={lang} dir={dir} data-langs={langs} data-page={page} data-site={sub} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!sub && languageAlternates(Astro.url.pathname).map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareTitle} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={shareTitle} />
    <link rel="alternate" type="application/rss+xml" title="AIUXAleem blog" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="AIUXAleem writing" href="/writing/rss.xml" />
    {jsonLd.filter(Boolean).map(o => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')} />)}
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0B1F36" />
    {manifest && <link rel="manifest" href={manifest} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Theme before first paint: ?theme (the checks' hook), then the stored choice, else dark, the site's default (owner instruction, 2 November 2026, L-38: the OS preference is not consulted; the visitor's choice from the theme button persists). The html element carries data-theme="dark" in the markup, so a page without JavaScript is dark too. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, q = new URLSearchParams(location.search), t = q.get('theme');
        if (t !== 'light' && t !== 'dark') { try { t = localStorage.getItem('aiuxaleem-theme'); } catch (e) {} }
        if (t !== 'light' && t !== 'dark') t = 'dark';
        d.setAttribute('data-theme', t);
        /* Motion is on when the visitor allows it and JavaScript runs: the GSAP module is fetched after the load event (below), and reveal.ts leaves the blocks it owns. */
        if (matchMedia('(prefers-reduced-motion: no-preference)').matches) d.setAttribute('data-motion', 'on');
      })();
    </script>
    {preload.map(href => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <!-- The GSAP module (islands/motion.ts bundled by scripts/perf/bundle-motion.mjs) is fetched after the load event, on an idle
         moment, and only when motion is allowed and this is not the admin: it is never on the path to the first paint or the
         largest paint (Lighthouse counts every early high-priority request against them). -->
    <script is:inline set:html={`addEventListener('load',function(){if(!document.documentElement.hasAttribute('data-motion')||document.querySelector('.admin-app'))return;(self.requestIdleCallback||function(f){setTimeout(f,300)})(function(){import(${JSON.stringify(motion.url)})},{timeout:2000})})`}></script>
    <!-- Page flow (owner, 5 November 2026): when a link leads from a card to its page, the card's picture travels into the
         page's cover, and on the way back the cover returns to its card. A cross-document view transition (motion.css opts in;
         Chrome and Edge 126 up): for its length the two carry the same view-transition-name. pagereveal fires at the new page's
         first render, before any module script runs, so this lives in the head. Nothing under reduced motion or in the admin. -->
    <script is:inline set:html={pageFlowScript}></script>
    {countVisits && <script is:inline set:html={countScript} />}
  </head>
  <body>
    {field && <AiField />}
    <slot />
    <script>
      import '../components/islands/site-chrome.ts';
      import '../components/islands/pointer.ts';
    </script>
    <script>
      import '../components/islands/reveal.ts';
    </script>
    <script>
      import '../components/islands/ink-aurora.ts';
    </script>
  </body>
</html>
