---
import '../styles/global.css';
import { site } from '../content/site';
import fonts from '../styles/fonts.json';
import { ogImageFor, abs, languageAlternates } from '../lib/seo';


interface Props {
  title: string;
  description: string;
  page?: string;
  langs?: string;
  lang?: string;
  dir?: string;
  noindex?: boolean;
  /** Canonical URL override, for a post republished from another site. */
  canonical?: string;
  /** Open Graph type. Pages are 'website'; posts and case studies are 'article'. */
  ogType?: string;
  /** Open Graph image path. Default: the image generated for this page (src/lib/seo.ts). */
  ogImage?: string;
  /** JSON-LD objects for this page. Empty entries are skipped. */
  jsonLd?: (Record<string, unknown> | undefined)[];
  /** A page of version 2 of the site (the A/B test, docs/AB_TEST.md): kept out of search, its visits still counted. */
  ab?: boolean;
}
const { title, description, page = '', langs = 'en', lang = 'en', dir = 'ltr', ab = false } = Astro.props;
const noindex = Astro.props.noindex || ab;
/* Fonts are self-hosted (src/styles/fonts.css). Only the faces used above the fold are preloaded. */
const preload = [...fonts.preload.latin, ...(lang === 'ar' ? fonts.preload.arabic : [])];
const { ogType = 'website', jsonLd = [] } = Astro.props;
const image = abs(Astro.props.ogImage || await ogImageFor(Astro.url.pathname));
/* The share title drops the site suffix; the site name is its own tag. */
const shareTitle = title.replace(/ · AIUXAleem$/, '');
/* Page view count: first-party, no cookie, sent after the page has loaded. Present only where the /api/hit route exists
   (the Vercel build and dev), never on pages marked noindex. Skipped in the owner's browser and for visitors who ask not
   to be tracked. */
const countVisits = import.meta.env.COUNT_VISITS === '1' && (!noindex || ab);
/* The A/B test (docs/AB_TEST.md) runs where visits are counted, so its result can be read in the admin: the Vercel site
   and dev. Static copies (GitHub Pages) always show version 1. */
const abSplit = import.meta.env.COUNT_VISITS === '1';
const abScript = "(function(){try{var n=navigator,u=n.userAgent||'';if(n.webdriver||/bot|crawl|spider|slurp|preview|lighthouse|headless|pagespeed|google|bing|yandex|baidu|duckduck|facebookexternalhit|embedly|whatsapp|telegram|discord|linkedin|slack|twitter/i.test(u))return;var K='aiuxaleem-ab',q=location.search.match(/[?&]ab=([12])/),p=location.pathname.replace(/\\.html$/,'').replace(/\\/$/,'')||'/',m={'/':'/v2','/services':'/v2/services','/contact':'/v2/contact'},v=q?q[1]:localStorage.getItem(K);if(v!=='1'&&v!=='2'){v=p.indexOf('/v2')===0?'2':m[p]?(Math.random()<0.5?'1':'2'):'';}if(!v)return;localStorage.setItem(K,v);document.documentElement.setAttribute('data-ab',v);var s=location.search.replace(/([?&])ab=[12]&?/,'$1').replace(/[?&]$/,'');if(v==='2'&&m[p])location.replace(m[p]+s+location.hash);else if(v==='1'&&q&&p.indexOf('/v2')===0){var b={'/v2':'/','/v2/services':'/services','/v2/contact':'/contact'}[p];if(b)location.replace(b+s+location.hash);}}catch(e){}})();";
const countScript = "(function(){try{if(navigator.doNotTrack==='1'||navigator.globalPrivacyControl||localStorage.getItem('aiuxaleem-owner')==='1')return;var s=function(){navigator.sendBeacon('/api/hit',JSON.stringify({p:location.pathname,r:document.referrer}))};if(document.readyState==='complete')s();else addEventListener('load',s,{once:true})}catch(e){}})();";
const canonical = Astro.props.canonical || new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
---
<!doctype html>
<html lang={lang} dir={dir} data-langs={langs} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {abSplit && <script is:inline set:html={abScript} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languageAlternates(Astro.url.pathname).map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareTitle} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={shareTitle} />
    <link rel="alternate" type="application/rss+xml" title="AIUXAleem blog" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="AIUXAleem writing" href="/writing/rss.xml" />
    {jsonLd.filter(Boolean).map(o => <script type="application/ld+json" set:html={JSON.stringify(o).replace(/</g, '\\u003c')} />)}
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0B1F36" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- Theme before first paint. Same order as the legacy boot script: ?theme, stored choice, system preference. -->
    <script is:inline>
      (function () {
        var d = document.documentElement, q = new URLSearchParams(location.search), t = q.get('theme');
        if (t !== 'light' && t !== 'dark') { try { t = localStorage.getItem('aiuxaleem-theme'); } catch (e) {} }
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-theme', t);
      })();
    </script>
    {preload.map(href => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    {countVisits && <script is:inline set:html={countScript} />}
  </head>
  <body>
    <slot />
    <script>
      import '../components/islands/site-chrome.ts';
    </script>
    <script>
      import '../components/islands/reveal.ts';
    </script>
    <script>
      import '../components/islands/ink-aurora.ts';
    </script>
  </body>
</html>
