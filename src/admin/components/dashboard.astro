---
/* Visitor dashboard: one section, "Visitor numbers", with the period chips on its heading row (they change the numbers
   under them), then a bento grid (admin.css, .admin-bento): four stat tiles with an ink icon tile beside each label
   (views, visitors, pages, busiest day), the chart, Top pages beside Where visitors came from, and the long tail
   (Countries and Devices) in one closed disclosure, so the first screen holds the numbers that matter.
   States: default; empty (no views in the period: says why and what to do); partial (a table has no rows); error (the
   numbers could not be read: says so and offers a retry). There is no loading state: the page is rendered on the server
   with the numbers already in it.
   The chart is one series, so it has no legend; the heading names it. Every bar shows its value on hover, and the same
   figures are in a table below it for keyboard and screen-reader users. Tile headings are h3 under the section's h2.
   Styles: src/styles/admin.css. */
import AdminIcon from './admin-icon.astro';
import type { Dashboard } from './dashboard-data';
import '../../styles/admin.css';

interface Props { data?: Dashboard; error?: string; range: number; ranges: readonly number[]; /** Where the range links point. */ base?: string;
  /** On /_states the dashboard is shown several times: render plain blocks with unique ids there, so the page does not gain repeated landmarks. */ plain?: boolean; uid?: string }
const { data, error, range, ranges, base = '/admin', plain = false, uid = 'dash' } = Astro.props;
const Block: any = plain ? 'div' : 'section';
const Nav: any = plain ? 'div' : 'nav';
const labelled = (id: string) => (plain ? {} : { 'aria-labelledby': `${uid}-${id}` });

const short = (day: string) => new Date(day + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const n = (v: number) => v.toLocaleString('en-GB');
const countryName = (code: string) => { if (!code) return 'Unknown'; try { return new Intl.DisplayNames(['en'], { type: 'region' }).of(code) || code; } catch { return code; } };
const deviceName: Record<string, string> = { desktop: 'Desktop', phone: 'Phone', tablet: 'Tablet' };
const max = data ? Math.max(1, ...data.series.map(d => d.views)) : 1;
const empty = !!data && data.totals.views === 0;
const peak = data && !empty ? data.series.reduce((a, b) => (b.views > a.views ? b : a)) : undefined;
const tiles = data ? [
  { icon: 'views', label: 'Page views', value: n(data.totals.views), note: `last ${data.days} days` },
  { icon: 'people', label: 'Visitors', value: n(data.totals.visitors), note: `last ${data.days} days` },
  { icon: 'pages', label: 'Pages visited', value: n(data.totals.pages), note: `last ${data.days} days` },
  { icon: 'busiest', label: 'Busiest day', value: peak ? short(peak.day) : '—', note: peak ? `${n(peak.views)} ${peak.views === 1 ? 'view' : 'views'}` : 'no views yet' },
] as const : [];
---
<Block class="dash" {...labelled('numbers-title')}>
  <div class="admin-section-head">
    <h2 id={`${uid}-numbers-title`} class="dash-h2"><AdminIcon name="numbers" />Visitor numbers</h2>
    <Nav class="dash-range" aria-label={plain ? undefined : 'Period'}>
      <span class="project-filter-label">Period</span>
      <ul>
        {ranges.map(r => <li><a class="ui-chip" href={`${base}?days=${r}`} aria-current={r === range ? 'page' : undefined}>{r} days</a></li>)}
      </ul>
    </Nav>
  </div>

  {error && (
    <div class="form-panel" role={plain ? undefined : 'alert'}>
      <AdminIcon name="alert" />
      <div>
        <p><strong>The visitor numbers could not be loaded.</strong></p>
        <p>{error}</p>
        <p><a data-link href={`${base}?days=${range}`}><AdminIcon name="refresh" size={16} />Try again</a></p>
      </div>
    </div>
  )}

  {data && (
    <div class="admin-bento">
      <ul class="cory-bento">
        <li class="span-4">
          <dl class="facts dash-tiles">
            {tiles.map(t => <div><dt><span data-icon-tile aria-hidden="true"><AdminIcon name={t.icon} size={22} /></span>{t.label}</dt><dd class="dash-number">{t.value}</dd><dd class="dash-stat-note">{t.note}</dd></div>)}
          </dl>
          <p class="form-note">Last {data.days} days, by UTC date. A visitor is counted once per day: the site keeps no cookie and no address, so it cannot tell that two days' visits came from the same person.</p>
        </li>

        {empty && (
          <li class="span-4">
            <div class="project-empty">
              <p class="project-empty-title"><AdminIcon name="info" />No visits recorded in this period.</p>
              <p class="project-empty-body">Counting starts when a page on the live site is opened. Visits from this browser while you are signed in, from robots, and from people who ask not to be tracked are not counted.</p>
              <p class="project-empty-body"><a data-link href="/">Open the home page</a> in a private window to record a first visit, then reload this page.</p>
            </div>
          </li>
        )}

        {!empty && (
          <li class="span-4">
            <div class="admin-card">
              <h3 class="admin-card-title"><AdminIcon name="chart" />Page views per day</h3>
              <div class="dash-chart" aria-hidden="true">
                <ol class="dash-bars" style={`--max: ${max};`}>
                  {data.series.map(d => (
                    <li style={`--v: ${d.views};`}>
                      <span class="dash-bar" data-zero={d.views === 0 ? '' : undefined}></span>
                      <span class="dash-tip"><strong>{short(d.day)}</strong>{n(d.views)} {d.views === 1 ? 'view' : 'views'} · {n(d.visitors)} {d.visitors === 1 ? 'visitor' : 'visitors'}</span>
                    </li>
                  ))}
                </ol>
                <p class="dash-axis"><span>{short(data.series[0].day)}</span><span>{short(data.series[data.series.length - 1].day)}</span></p>
              </div>
              <details class="dash-details">
                <summary>Show these figures as a table</summary>
                <div class="post-table" tabindex="0" role={plain ? undefined : 'region'} aria-label={plain ? undefined : 'Page views per day'}>
                  <table>
                    <thead><tr><th scope="col">Day</th><th scope="col" class="dash-num">Views</th><th scope="col" class="dash-num">Visitors</th></tr></thead>
                    <tbody>{[...data.series].reverse().map(d => <tr><th scope="row">{short(d.day)}</th><td class="dash-num">{n(d.views)}</td><td class="dash-num">{n(d.visitors)}</td></tr>)}</tbody>
                  </table>
                </div>
              </details>
            </div>
          </li>
        )}

        {!empty && (
          <li class="span-2">
            <div class="admin-card" data-dash-pages>
              <h3 class="admin-card-title"><AdminIcon name="top" />Top pages</h3>
              <div class="post-table dash-table"><table>
                <thead><tr><th scope="col">Page</th><th scope="col" class="dash-num">Views</th><th scope="col" class="dash-num">Visitors</th></tr></thead>
                <tbody>{data.pages.map(p => <tr><th scope="row"><a data-link href={p.path}>{p.path === '/' ? 'Home' : p.path}</a></th><td class="dash-num">{n(p.views)}</td><td class="dash-num">{n(p.visitors)}</td></tr>)}</tbody>
              </table></div>
            </div>
          </li>
        )}
        {!empty && (
          <li class="span-2">
            <div class="admin-card">
              <h3 class="admin-card-title"><AdminIcon name="referrers" />Where visitors came from</h3>
              {data.referrers.length === 0 ? <p class="form-note">No referring sites recorded yet.</p> : (
                <div class="post-table dash-table"><table>
                  <thead><tr><th scope="col">Site</th><th scope="col" class="dash-num">Views</th></tr></thead>
                  <tbody>{data.referrers.map(r => <tr><th scope="row">{r.host || 'Direct, or not stated'}</th><td class="dash-num">{n(r.views)}</td></tr>)}</tbody>
                </table></div>
              )}
            </div>
          </li>
        )}
        {!empty && (
          <li class="span-4">
            <details class="resource-disclosure admin-fold">
              <summary><AdminIcon name="countries" size={18} /><span data-disclosure-state>Countries and devices</span><AdminIcon name="chevron" size={16} data-chevron /></summary>
              <div class="admin-row">
                <div>
                  <h3 class="admin-card-title"><AdminIcon name="countries" />Countries</h3>
                  {data.countries.length === 0 ? <p class="form-note">No countries recorded yet.</p> : (
                    <div class="post-table dash-table"><table>
                      <thead><tr><th scope="col">Country</th><th scope="col" class="dash-num">Views</th></tr></thead>
                      <tbody>{data.countries.map(c => <tr><th scope="row">{countryName(c.country)}</th><td class="dash-num">{n(c.views)}</td></tr>)}</tbody>
                    </table></div>
                  )}
                </div>
                <div>
                  <h3 class="admin-card-title"><AdminIcon name="devices" />Devices</h3>
                  <div class="post-table dash-table"><table>
                    <thead><tr><th scope="col">Device</th><th scope="col" class="dash-num">Views</th></tr></thead>
                    <tbody>{data.devices.map(d => <tr><th scope="row">{deviceName[d.device] || d.device}</th><td class="dash-num">{n(d.views)}</td></tr>)}</tbody>
                  </table></div>
                </div>
              </div>
            </details>
          </li>
        )}
      </ul>
    </div>
  )}
</Block>
