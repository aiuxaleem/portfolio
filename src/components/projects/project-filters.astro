---
/* Filters for the project list: toggle buttons for tags and status, each with its count when the list is given, a
   live result count with a "Clear filters" action once a filter is on, and an empty state with the same action.
   Within a group any selected value matches; every group must match (the design's Work page and the Resources page
   narrow the same way). Only values that at least one listed item has are offered when the list is given, so no
   choice leads to an empty list. Buttons are real <button>s with aria-pressed, so they work from the keyboard. The bar
   is in the page from the first paint, so nothing moves when the script starts; without JavaScript a <noscript> rule
   hides it and every item is listed. Behaviour: islands/project-filters.ts */
import Button from '../ui/button.astro';
import { statusLabel } from '../../lib/projects';

interface Props { tags: string[]; total: number; /** The listed items, for the counts beside each chip. */ items?: { tags: string[]; status: string }[]; /** Render the empty state open, for /_states. */ showEmpty?: boolean; /** The second filter group. Default: project status. */ options?: Record<string, string>; optionsLabel?: string; /** What is counted, singular. */ noun?: string; id?: string }
const { tags, total, items, showEmpty = false, options = statusLabel, optionsLabel = 'Status', noun = 'project', id = 'filter' } = Astro.props;
const countOf = (f: (item: { tags: string[]; status: string }) => boolean) => (items ? items.filter(f).length : undefined);
const tagChips = tags.map(t => ({ value: t, label: t, n: countOf(i => i.tags.includes(t)) })).filter(c => c.n === undefined || c.n > 0);
const statusChips = Object.entries(options).map(([value, label]) => ({ value, label, n: countOf(i => i.status === value) })).filter(c => c.n === undefined || c.n > 0);
const nouns = total === 1 ? noun : `${noun}s`;
---
<noscript><style>[data-project-filters] { display: none; }</style></noscript>
<div class="project-filters" data-project-filters data-noun={noun}>
  {tagChips.length > 0 && (
    <div role="group" aria-labelledby={`${id}-tags`} class="project-filter-group">
      <span id={`${id}-tags`} class="project-filter-label">Topic</span>
      {tagChips.map(c => <button type="button" class="ui-chip" aria-pressed="false" data-filter-tag={c.value}>{c.label}{c.n !== undefined && <Fragment><span class="cory-visually-hidden">, </span><span aria-hidden="true">·</span>{c.n}</Fragment>}</button>)}
    </div>
  )}
  {statusChips.length > 0 && (
    <div role="group" aria-labelledby={`${id}-status`} class="project-filter-group">
      <span id={`${id}-status`} class="project-filter-label">{optionsLabel}</span>
      {statusChips.map(c => <button type="button" class="ui-chip" aria-pressed="false" data-filter-status={c.value}>{c.label}{c.n !== undefined && <Fragment><span class="cory-visually-hidden">, </span><span aria-hidden="true">·</span>{c.n}</Fragment>}</button>)}
    </div>
  )}
  <div class="project-filter-group">
    <p class="project-filter-count" role="status" aria-live="polite" data-result-count data-total={total}>{showEmpty ? `Showing 0 of ${total} ${nouns}` : `${total} ${nouns}`}</p>
    <Button variant="ghost" data-clear-filters hidden={!showEmpty}>Clear filters</Button>
  </div>
</div>
<div class="project-empty" data-project-empty hidden={!showEmpty}>
  <p class="project-empty-title">No {noun}s match these filters.</p>
  <p class="project-empty-body">Try removing a filter, or clear them all to see every {noun}.</p>
  <div><Button variant="secondary" data-clear-filters>Clear filters</Button></div>
</div>
