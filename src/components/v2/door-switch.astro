---
/* Version 2 (docs/AB_TEST.md): the way across to the other door. A short band at the foot of the page for hiring teams
   (to the client page) and on the client page (to the hiring page), so a visitor who came in by the wrong door is one
   click from the right one. One link, a secondary button: the page's own call to action stays the primary one. */
import Button from '../ui/button.astro';

interface Props { to: 'hiring' | 'clients'; id: string; /** Off on /_states, where landmark names must be unique. */ landmark?: boolean }
const { to, id, landmark = true } = Astro.props;
const Wrap: any = landmark ? 'section' : 'div';
const copy = to === 'hiring'
  ? { overline: 'Hiring instead?', title: 'There is a page written for hiring teams', body: 'The experience, the case studies, the resume and the certifications, for a Lead or Principal role in KSA or the UAE.', cta: 'See the page for hiring teams', href: '/v2/hiring' }
  : { overline: 'Building a product instead?', title: 'There is a page written for clients', body: 'What I do on a project, what you get and how an engagement starts: AI product design, design systems and UX audits.', cta: 'See how I work with clients', href: '/v2/services' };
---
<Wrap class="cory-container door-switch-wrap" aria-labelledby={landmark ? `${id}-title` : undefined}>
  <div class="door-switch">
    <div class="door-switch-words">
      <p class="cory-overline" style="margin: 0;">{copy.overline}</p>
      <h2 id={`${id}-title`} class="door-switch-title">{copy.title}</h2>
      <p class="door-switch-body">{copy.body}</p>
    </div>
    <Button variant="secondary" size="lg" href={copy.href}>{copy.cta}</Button>
  </div>
</Wrap>

<style>
  .door-switch-wrap { padding-block: var(--space-12); }
  .door-switch { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6); padding: var(--space-8); border-radius: var(--radius-xl); background: var(--surface-card); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); }
  .door-switch-words { display: grid; gap: var(--space-2); flex: 1 1 28rem; min-inline-size: 0; }
  .door-switch-title { margin: 0; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h3); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--text-strong); overflow-wrap: anywhere; }
  .door-switch-body { margin: 0; max-inline-size: var(--measure-body); color: var(--text-muted); }
</style>
