---
/* The projects with their topic and status filters, grouped by status: the main site's /work list (src/pages/work/index.astro),
   as a component for the audience websites (docs/SITES.md), whose pages have their own first screen. The main site's
   page keeps its own copy, so version 1 of the A/B test does not change. */
import ProjectCard from '../cards/project-card.astro';
import ProjectFilters from '../projects/project-filters.astro';
import Button from '../ui/button.astro';
import { listedProjects } from '../../lib/projects';

const projects = await listedProjects();
const groups = [
  { status: 'shipped', title: 'Shipped', blurb: 'Live, in use, and linked to where you can see it.' },
  { status: 'in-progress', title: 'In progress', blurb: 'Being designed and built now, with updates as it moves.' },
  { status: 'concept', title: 'Concepts', blurb: 'Ideas explored far enough to show the thinking.' },
] as const;
const ordered = groups.map(g => ({ ...g, list: projects.filter(p => p.data.status === g.status) })).filter(g => g.list.length > 0);
const tags = [...new Set(projects.filter(p => !p.data.fixture).flatMap(p => p.data.tags))].sort();
---
<section id="projects" class="cory-container" aria-label="Project list" style="display: grid; gap: var(--space-8); padding-block: var(--space-8) var(--section-y);">
  <ProjectFilters tags={tags} total={projects.length} items={projects.map(p => ({ tags: p.data.tags, status: p.data.status }))} />
  {projects.length === 0
    ? <div class="project-empty"><p class="project-empty-title">No projects are published yet.</p><p class="project-empty-body">The case studies cover the work in depth.</p><div><Button variant="secondary" href="/case-studies">Read the case studies</Button></div></div>
    : <div id="project-list" data-project-list class="dir-groups">
        {ordered.map(g => (
          <section class="dir-group" aria-labelledby={`dir-${g.status}`}>
            <div class="page-section-head">
              <h2 id={`dir-${g.status}`} class="project-h2">{g.title} <span class="dir-count">{g.list.length}</span></h2>
              <p class="project-filter-count">{g.blurb}</p>
            </div>
            <div data-cq><ul data-cq-balance style="display: grid; gap: var(--grid-gap);">{g.list.map(p => <li><ProjectCard project={p} /></li>)}</ul></div>
          </section>
        ))}
      </div>}
</section>

<style>
  .dir-groups { display: grid; gap: var(--space-12); }
  .dir-group { display: grid; gap: var(--space-5); }
  .dir-count { font-family: var(--font-mono); font-size: var(--text-mono); font-weight: var(--weight-medium); color: var(--text-subtle); vertical-align: middle; }
  .dir-group:not(:has(li:not([hidden]))) { display: none; }
</style>

<script>
  import '../islands/project-filters.ts';
</script>
