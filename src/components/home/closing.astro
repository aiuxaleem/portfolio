---
/* Home closing panel, carried over from the legacy page. The call link, email and resume link come from site settings. */
import { site, resumeAttrs, resumeExternal } from '../../content/site';
---
<section id="contact" data-section="" data-closing="" aria-labelledby="contact-title" style="position: relative; padding-block: var(--space-10) var(--space-24);">
    <div class="cory-container">
      <div data-reveal="" style="position: relative; overflow: hidden; isolation: isolate; border-radius: var(--radius-2xl); background: var(--gradient-ink); color: var(--on-ink-body); padding: clamp(var(--space-12), 9vw, var(--space-24)) var(--gutter); display: grid; gap: var(--space-8); justify-items: center; text-align: center; box-shadow: var(--shadow-xl);">
        <div aria-hidden="true" style="position: absolute; inline-size: 60%; aspect-ratio: 1 / 1; inset-inline-end: -22%; inset-block-start: -35%; background: var(--glow-cyan-strong); z-index: -1; pointer-events: none;"></div>
        <div aria-hidden="true" style="position: absolute; inline-size: 50%; aspect-ratio: 1 / 1; inset-inline-start: -18%; inset-block-end: -40%; background: var(--glow-blue); z-index: -1; pointer-events: none;"></div>
        <p class="cory-overline" style="margin: 0px; color: var(--on-ink-link);"><span class="sc-interp">Next step</span></p>
        <h2 id="contact-title" style="margin: 0px; max-inline-size: 20ch; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-display); line-height: var(--leading-tight); letter-spacing: var(--tracking-tighter); color: var(--on-ink-strong);"><span class="sc-interp">Have a product that needs to feel trustworthy? Let's talk.</span></h2>
        <p style="margin: 0px; max-inline-size: var(--measure-lead); font-size: var(--text-fluid-lead); line-height: var(--leading-relaxed); color: var(--on-ink-body);"><span class="sc-interp">I reply within 48 hours. A 15-minute call is the fastest way to start.</span></p>
        <div style="display: grid; justify-items: center; gap: var(--space-6);">
          <div data-cta-row="" style="display: flex; gap: var(--space-3); flex-wrap: wrap; justify-content: center; align-items: center;">
            <span style="display: inline-block; padding: var(--space-2); margin: calc(var(--space-2) * -1);"><div class="sc-host-x" style="display: contents;"><a href={site.calendarUrl} target="_blank" rel="noopener" style="position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; min-height: 52px; font-size: var(--text-ui-lg); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--gradient-brand-deep); color: var(--text-on-brand); box-shadow: var(--shadow-brand); border: 1px solid transparent;" data-ds-button="primary"><span style="display: inline-flex; align-items: center; gap: 10px; visibility: visible;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><path d="M3 10h18"></path><rect x="3" y="4" width="18" height="18" rx="2"></rect></svg><span class="sc-interp">Book a 15-min call</span></span><span class="cory-visually-hidden"> (opens in a new tab)</span></a></div></span>
            <div class="sc-host-x" style="display: contents;"><a href={`mailto:${site.email}?subject=Role%20or%20project%20conversation`} style="position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; min-height: 52px; font-size: var(--text-ui-lg); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--on-ink-fill); color: var(--on-ink-strong); box-shadow: none; border: 1px solid var(--on-ink-border-strong);" data-ds-button="on-ink"><span style="display: inline-flex; align-items: center; gap: 10px; visibility: visible;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg><span class="sc-interp">Email me</span></span></a></div>
          </div>
          <div style="display: flex; gap: var(--space-2) var(--space-6); flex-wrap: wrap; justify-content: center; align-items: center; color: var(--on-ink-link); font-size: var(--text-body-sm);">
            <div class="sc-host" data-sc-name="Email Copy"><span style="display: inline-flex; align-items: center; gap: var(--space-1); flex-wrap: wrap; color: inherit;" data-email-copy="" data-copied="Copied" data-fallback="Selected. Press Ctrl+C or Cmd+C to copy.">
  <a data-email="" data-link="" href={`mailto:${site.email}?subject=Role%20or%20project%20conversation`} lang="en" dir="ltr" style="display: inline-flex; align-items: center; min-block-size: var(--tap-target); font-weight: var(--weight-semibold); color: inherit; text-decoration: none; overflow-wrap: anywhere;"><span class="sc-interp">{site.email}</span></a>
  <button type="button" aria-label="Copy email address" title="Copy email address" class="scp3 scp4" style="display: inline-grid; place-items: center; inline-size: var(--tap-target); block-size: var(--tap-target); border: 0px; border-radius: var(--radius-pill); background: transparent; color: inherit; cursor: pointer; transition: background var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out);">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
    
  </button>
  <span role="status" aria-live="polite" style="font-size: var(--text-caption); color: inherit; opacity: var(--opacity-muted);"><span class="sc-interp"></span></span></span></div>
            
            
            <a data-link="" href={site.resumeUrl} {...resumeAttrs} style="display: inline-flex; align-items: center; min-block-size: var(--tap-target); font-weight: var(--weight-semibold); color: var(--on-ink-link); text-decoration: none;"><span class="sc-interp">{resumeExternal ? 'View resume' : 'Download resume'}</span>{resumeExternal && <span class="cory-visually-hidden"> (opens in a new tab)</span>}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
