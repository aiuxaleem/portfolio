---
/* Home hero. Markup and inline styles are carried over from the legacy page so it looks the same; its content is wired up:
   the availability line and resume link come from site settings, the title from the profile file, "Worked with" from the
   career list. The card deck beside it is case-deck.astro */
import { site, resumeAttrs, resumeExternal } from '../../content/site';
import { profile, careerByCompany } from '../../content/profile';
import CaseDeck from './case-deck.astro';

/** The first three employers, newest first. */
const employers = careerByCompany().slice(0, 3).map(g => g.company);

---
<section id="top" data-section="" data-hero="" aria-labelledby="hero-title" style="position: relative; min-block-size: calc(100svh - var(--header-height)); display: flex; align-items: center; padding-block: clamp(var(--space-10), 7svh, var(--space-20)) var(--space-16); overflow: clip;">
    <div class="cory-container cory-split" style="gap: var(--space-12) var(--space-10); align-items: center;">
      <div style="display: grid; gap: var(--space-6); align-content: center;">
        
        <div data-hero-el="" style="display: flex; align-items: center; flex-wrap: wrap; min-block-size: var(--space-7);">
          <div class="sc-host-x" style="display: contents;"><span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; font-size: var(--text-caption); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1.2; border-radius: var(--radius-pill); background: var(--green-100); color: var(--green-700); white-space: nowrap;" data-badge=""><span style="width: 6px; height: 6px; border-radius: 50%; background: var(--green-500); flex-shrink: 0;"></span><span class="sc-interp">{site.availability.label}</span></span></div>
        </div>
        <h1 id="hero-title" data-hero-title="" style="margin: 0px; max-inline-size: 14ch; min-block-size: calc(2 * var(--leading-tight) * 1em); font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-display); line-height: var(--leading-tight); letter-spacing: var(--tracking-tighter); color: var(--text-strong); text-wrap: balance;"><span class="sc-interp">I design AI products people actually </span><span style="background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent;"><span class="sc-interp">trust</span></span><span class="sc-interp">.</span></h1>
        <p data-hero-el="" style="margin: 0px; max-inline-size: var(--measure-lead); min-block-size: calc(2 * var(--leading-relaxed) * 1em); font-size: var(--text-fluid-lead); line-height: var(--leading-relaxed); color: var(--text-body);"><span class="sc-interp">{profile.headline} with 13+ years across fintech and enterprise platforms. I set the direction, grow the team and ship design as code, from roadmap to handoff.</span></p>
        <div data-hero-el="" data-hero-ctas="" style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; min-block-size: var(--space-12);">
          <div class="sc-host-x" style="display: contents;"><a href="/case-studies" hreflang="en" style="position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; min-height: 52px; font-size: var(--text-ui-lg); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--gradient-brand-deep); color: var(--text-on-brand); box-shadow: var(--shadow-brand); border: 1px solid transparent;" data-ds-button="primary"><span style="display: inline-flex; align-items: center; gap: 10px; visibility: visible;"><span class="sc-interp">See all work</span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a></div>
          <div class="sc-host-x" style="display: contents;"><a href={site.resumeUrl} {...resumeAttrs} style="position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; min-height: 52px; font-size: var(--text-ui-lg); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--surface-card); color: var(--text-strong); box-shadow: var(--shadow-xs); border: 1px solid var(--border-interactive);" data-ds-button="secondary"><span style="display: inline-flex; align-items: center; gap: 10px; visibility: visible;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg><span class="sc-interp">{resumeExternal ? 'View resume' : 'Download resume'}</span>{resumeExternal && <span class="cory-visually-hidden"> (opens in a new tab)</span>}</span></a></div>
        </div>
        <div data-hero-el="" style="display: grid; gap: var(--space-3); margin-block-start: var(--space-4); padding-block-start: var(--space-6); border-block-start: 1px solid var(--border-subtle);">
          <p style="margin: 0px; font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle);"><span class="sc-interp">Worked with</span></p>
          <ul style="display: flex; align-items: center; gap: var(--space-2) var(--space-6); flex-wrap: wrap;">
{employers.map(name => <li lang="en" dir="ltr" style="white-space: nowrap; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-body-lg); letter-spacing: var(--tracking-tight); color: var(--text-muted);"><span class="sc-interp">{name}</span></li>)}
</ul>
        </div>
      </div>

      <CaseDeck />
    </div>
  </section>
