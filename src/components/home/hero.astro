---
/* Home hero, as designed in Claude Design (design/claude-design/AIUXAleem Home.dc.html). Markup and inline styles are
   carried over from the design so it looks the same; its content is wired up: the resume link comes from site settings
   and the job title from the profile file. The four lines under the buttons say what kind of designer this is.
   The card deck beside it is case-deck.astro */
import { site, resumeAttrs, resumeExternal } from '../../content/site';
import { profile } from '../../content/profile';
import CaseDeck from './case-deck.astro';

const roles = ['solves problems', 'shapes strategy', 'leads decisions', 'drives clarity'];
const externalTile = "<span data-arrow-tile=\"\" aria-hidden=\"true\" style=\"display: inline-grid; place-items: center; inline-size: 28px; block-size: 28px; border-radius: var(--radius-pill); background: var(--surface-sunken); color: inherit; flex-shrink: 0; margin-inline-end: calc(-1 * var(--space-2));\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span>";
const downloadTile = "<span data-arrow-tile=\"\" aria-hidden=\"true\" style=\"display: inline-grid; place-items: center; inline-size: 28px; block-size: 28px; border-radius: var(--radius-pill); background: var(--surface-sunken); color: inherit; flex-shrink: 0; margin-inline-end: calc(-1 * var(--space-2));\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path><path d=\"m7 10 5 5 5-5\"></path><path d=\"M12 15V3\"></path></svg></span>";
---
<section id="top" data-section="" data-hero="" aria-labelledby="hero-title" style="position: relative; min-block-size: min(calc(100svh - var(--header-height)), 820px); display: flex; align-items: center; padding-block: clamp(var(--space-6), 4svh, var(--space-12)); overflow: clip;">
    <div class="cory-container cory-split" style="gap: var(--space-10) var(--space-10); align-items: stretch;">
      <div style="display: grid; gap: var(--space-5); align-content: center;">

        <h1 id="hero-title" data-hero-title="" style="margin: 0px; max-inline-size: 18ch; min-block-size: calc(2 * var(--leading-snug) * 1em); font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-title); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--text-strong); text-wrap: balance;"><span class="sc-interp">I design </span><span style="background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent;"><span class="sc-interp">AI</span></span><span class="sc-interp"> products people actually </span><span style="background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent;"><span class="sc-interp">trust</span></span></h1>
        <p data-hero-el="" style="margin: 0px; max-inline-size: var(--measure-lead); min-block-size: calc(2 * var(--leading-relaxed) * 1em); font-size: var(--text-fluid-lead); line-height: var(--leading-relaxed); color: var(--text-body);"><span class="sc-interp">{profile.headline} with 13+ years across fintech and enterprise platforms. I set the direction, grow the team and ship design as code, from roadmap to handoff.</span></p>
        <div data-hero-el="" data-hero-ctas="" style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center; min-block-size: var(--space-12);">
          <div class="sc-host-x" style="display: contents;"><a href="/case-studies" hreflang="en" style="position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; min-height: 52px; font-size: var(--text-ui-lg); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--gradient-brand-deep); color: var(--text-on-brand); box-shadow: var(--shadow-brand); border: 1px solid transparent;" data-ds-button="primary"><span style="display: inline-flex; align-items: center; gap: 10px; visibility: visible;"><span class="sc-interp">See all work</span><span data-arrow-tile="" data-dir-icon="" aria-hidden="true" style="display: inline-grid; place-items: center; inline-size: 28px; block-size: 28px; border-radius: var(--radius-pill); background: var(--on-ink-fill); color: inherit; flex-shrink: 0; margin-inline-end: calc(-1 * var(--space-2));"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></span></a></div>
          <div class="sc-host-x" style="display: contents;"><a href={site.resumeUrl} {...resumeAttrs} style="position: relative; display: inline-flex; width: auto; align-items: center; justify-content: center; gap: 10px; padding: 15px 30px; min-height: 52px; font-size: var(--text-ui-lg); font-family: var(--font-sans); font-weight: var(--weight-semibold); line-height: 1; letter-spacing: var(--tracking-ui); border-radius: var(--radius-pill); text-decoration: none; cursor: pointer; opacity: 1; transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out), filter var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out); white-space: nowrap; transform: none; background: var(--surface-card); color: var(--text-strong); box-shadow: var(--shadow-xs); border: 1px solid var(--border-interactive);" data-ds-button="secondary"><span style="display: inline-flex; align-items: center; gap: 10px; visibility: visible;"><span class="sc-interp">{resumeExternal ? 'View resume' : 'Download resume'}</span>{resumeExternal && <span class="cory-visually-hidden"> (opens in a new tab)</span>}{resumeExternal ? <Fragment set:html={externalTile} /> : <Fragment set:html={downloadTile} />}</span></a></div>
        </div>
        <div data-hero-el="" data-cq="" style="margin-block-start: var(--space-3);">
          <ul data-hero-roles="" data-cq-grid="4" style="display: grid; gap: var(--space-4) var(--space-6);">
            {roles.map((text, i) => (
              <li style="position: relative; display: grid; gap: var(--space-1); align-content: start; padding-block-start: var(--space-3); border-block-start: 1px solid var(--border-default);">
                <span style="display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle); white-space: nowrap;"><bdi style="font-family: var(--font-mono); font-size: var(--text-mono-sm); color: var(--text-link); font-variant-numeric: tabular-nums;">{String(i + 1).padStart(2, '0')}</bdi><span>Designer who</span></span>
                <span style="font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h3); line-height: var(--leading-snug); letter-spacing: var(--tracking-tight); color: var(--text-strong); text-wrap: balance;">{text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <CaseDeck />
    </div>
  </section>
