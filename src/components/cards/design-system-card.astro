---
/* Card for one public design system on Resources > Design Systems (/design-systems, L-68). A tile with its own links, not a
   stretched link, because a system has up to five places worth opening: its docs (the title), its code, its Figma kit, its
   tokens and what it offers AI agents. Each link says where it goes; a link the maker does not publish is left out, never
   shown empty. The data attributes are what the filter island reads (islands/project-filters.ts). States: every link,
   docs only, a fixture with long strings and eight strengths' worth of tags. */
import { type DesignSystem, strengthLabel, kindLabel, platformLabel, hostOf } from '../../lib/design-systems';

interface Props { system: DesignSystem; level?: 2 | 3 }
const { system, level = 3 } = Astro.props;
const d = system.data;
const Heading = `h${level}` as any;
const letter = d.title.trim().charAt(0).toUpperCase();
const host = hostOf(d.url);
const platforms = d.platforms.map(p => platformLabel[p]).join(', ');
const arrow = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"></path></svg>';
const links = [
  d.code && { label: d.code.license ? `Code · ${d.code.license}` : 'Code', href: d.code.url },
  d.figma && { label: 'Figma kit', href: d.figma },
  d.tokens && { label: 'Tokens', href: d.tokens.url, title: d.tokens.label },
  ...d.ai.map(a => ({ label: a.label, href: a.url })),
].filter(Boolean) as { label: string; href: string; title?: string }[];
---
<article class="tile ds-card" data-project data-status={d.kind} data-tags={d.strengths.join('|')} data-text={[d.title, d.maker, host, d.summary, platforms, ...d.tags].filter(Boolean).join(' ')}>
  <div class="ds-card-head">
    <span class="ds-card-mark" aria-hidden="true">{letter}</span>
    <div class="ds-card-name">
      <Heading class="ds-card-title">{d.url ? <a href={d.url} target="_blank" rel="noopener">{d.title}<span class="cory-visually-hidden"> (opens {host} in a new tab)</span></a> : d.title}</Heading>
      <p class="case-kicker">{d.maker}{' · '}{kindLabel[d.kind]}</p>
    </div>
  </div>
  <p class="ds-card-summary">{d.summary}</p>
  {(platforms || d.accessibility) && (
    <dl class="ds-card-facts">
      {platforms && <div><dt>Platforms</dt><dd>{platforms}</dd></div>}
      {d.accessibility && <div><dt>Accessibility</dt><dd>{d.accessibility}</dd></div>}
    </dl>
  )}
  {d.strengths.length > 0 && <p class="project-card-meta"><span class="cory-visually-hidden">Strong in: </span>{d.strengths.map(s => <span class="ui-badge">{strengthLabel[s]}</span>)}</p>}
  {links.length > 0 && (
    <ul class="ds-card-links" aria-label={`More from ${d.title}`}>
      {links.map(l => <li><a href={l.href} target="_blank" rel="noopener" title={l.title}>{l.label}<span class="cory-visually-hidden">, {d.title} (opens {hostOf(l.href)} in a new tab)</span> <Fragment set:html={arrow} /></a></li>)}
    </ul>
  )}
</article>

<style>
  .ds-card { display: grid; gap: var(--space-4); align-content: start; grid-template-rows: auto auto auto auto 1fr; min-inline-size: 0; block-size: 100%; }
  .ds-card-head { display: flex; align-items: flex-start; gap: var(--space-3); min-inline-size: 0; }
  .ds-card-name { display: grid; gap: 2px; min-inline-size: 0; }
  .ds-card-name .case-kicker { font-size: var(--text-caption); overflow-wrap: break-word; }
  .ds-card-mark { flex-shrink: 0; display: grid; place-items: center; inline-size: var(--tap-target); block-size: var(--tap-target); border-radius: var(--radius-md); background: var(--gradient-ink); color: var(--on-ink-strong); font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h4); border: 1px solid var(--border-default); }
  .ds-card-title { margin: 0; font-size: var(--text-h4); font-weight: var(--weight-bold); line-height: var(--leading-heading); color: var(--text-strong); overflow-wrap: anywhere; }
  .ds-card-title a { display: inline-flex; align-items: center; min-block-size: var(--tap-target); min-inline-size: var(--tap-target); color: inherit; text-decoration: none; }
  @media (hover: hover) { .ds-card-title a:hover { color: var(--text-link); text-decoration: underline; text-underline-offset: 3px; } }
  .ds-card-title a:focus-visible { color: var(--text-link); text-decoration: underline; text-underline-offset: 3px; }
  .ds-card-summary { margin: 0; font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--text-body); }
  .ds-card-facts { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); }
  .ds-card-facts > div { display: grid; gap: 2px; min-inline-size: 0; }
  .ds-card-facts dt { font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle); }
  .ds-card-facts dd { margin: 0; font-size: var(--text-body-sm); color: var(--text-strong); overflow-wrap: anywhere; }
  .ds-card-links { margin: 0; padding: var(--space-3) 0 0; list-style: none; display: flex; flex-wrap: wrap; align-self: end; gap: 0 var(--space-4); border-block-start: 1px solid var(--border-subtle); }
  .ds-card-links a { display: inline-flex; align-items: center; gap: var(--space-1); min-block-size: var(--tap-target); font-size: var(--text-body-sm); font-weight: var(--weight-semibold); color: var(--text-link); text-decoration: none; overflow-wrap: anywhere; }
  @media (hover: hover) { .ds-card-links a:hover { text-decoration: underline; text-underline-offset: 3px; } }
  .ds-card-links a:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
</style>
