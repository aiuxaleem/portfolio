---
/* Blog post card. Same card recipe as the project card: one link, the whole card clickable, fixed media ratio.
   States: with cover, without cover (typographic fallback), optional dates and tags. */
import FittedImage from '../ui/fitted-image.astro';
import { type Post, postUrl, formatDate, readingTime, topicsOf } from '../../lib/posts';

interface Props { post: Post; level?: 2 | 3; /** The lead card of a list: picture and words side by side where there is room. */ wide?: boolean }
const { post, level = 2, wide = false } = Astro.props;
const d = post.data;
const Heading = `h${level}` as any;
const date = d.published || d.updated;
const time = readingTime(post);
const topics = await topicsOf(post);
---
<article class:list={['project-card', wide && 'case-card-wide']}>
  <div class="project-card-media">
    {d.cover
      ? <FittedImage image={d.cover} widths={[400, 640, 960]} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" />
      : <div data-cover-fallback="label" aria-hidden="true"><span>{['Blog post', d.category].filter(Boolean).join(' · ')}</span></div>}
  </div>
  <div class="project-card-body">
    {(date || time) && <p class="case-kicker">{date && <>{!d.published && 'Updated '}<time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></>}{date && time && ' · '}{time}</p>}
    <Heading class="project-card-title"><a class="project-card-link" href={postUrl(post)}>{d.title}</a></Heading>
    <p class="project-card-summary">{d.excerpt}</p>
    {topics.length > 0 && <ul class="project-card-tags" aria-label="Tags">{topics.map(t => <li><span class="ui-badge">{t}</span></li>)}</ul>}
    <span class="project-card-cta" aria-hidden="true">Read the post <svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span>
  </div>
</article>
