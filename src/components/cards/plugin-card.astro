---
/* One entry of Anthropic's official plugin directory on /claude-skills (L-63): the AI tool card's recipe, one link (where
   the plugin is published) and the whole card clickable, the maker, Anthropic or partner, the category, "New" when the
   weekly refresh first saw it in the last 30 days, and the one-line install. The words are the directory's own, so they
   are shown as given (clamped by the refresh). The data attributes are what the filter island reads. */
import { type Plugin, categoryLabel, isNew } from '../../lib/claude-plugins';

interface Props { plugin: Plugin; level?: 2 | 3 }
const { plugin: p, level = 3 } = Astro.props;
const Heading = `h${level}` as any;
const host = (() => { try { return new URL(p.link).hostname.replace(/^www\./, ''); } catch { return ''; } })();
const letter = p.title.trim().charAt(0).toUpperCase();
const fresh = isNew(p);
---
<article class="project-card plugin-card" data-project data-status={p.official ? 'anthropic' : 'partner'} data-tags={p.category} data-text={[p.title, p.name, p.author, p.description].join(' ')}>
  <div class="project-card-body">
    <div class="plugin-head">
      <span class="plugin-mark" aria-hidden="true">{letter}</span>
      <div class="plugin-name">
        <Heading class="project-card-title"><a class="project-card-link" href={p.link} target="_blank" rel="noopener">{p.title}<span class="cory-visually-hidden"> (opens {host} in a new tab)</span></a></Heading>
        {p.author && <p class="case-kicker">{p.author}</p>}
      </div>
    </div>
    <p class="project-card-summary">{p.description}</p>
    <p class="plugin-install"><span class="plugin-install-label">Install in Claude Code</span><code dir="ltr" lang="en">{p.install}</code></p>
    <p class="project-card-meta">{fresh && <span class="ui-badge" data-tone="success">New</span>}<span class="ui-badge" data-tone={p.official ? 'brand' : undefined}>{p.official ? 'By Anthropic' : 'Partner'}</span><span class="ui-badge">{categoryLabel(p.category)}</span></p>
    <span class="project-card-cta" aria-hidden="true">See it on <bdi>{host}</bdi> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"></path></svg></span>
  </div>
</article>

<style>
  .plugin-card { min-inline-size: 0; }
  .plugin-head { display: flex; align-items: center; gap: var(--space-3); min-inline-size: 0; }
  .plugin-name { display: grid; gap: 2px; min-inline-size: 0; }
  .plugin-name .project-card-title, .plugin-name .case-kicker { overflow-wrap: anywhere; }
  .plugin-mark { flex-shrink: 0; display: grid; place-items: center; inline-size: var(--tap-target); block-size: var(--tap-target); border-radius: var(--radius-md); background: var(--gradient-ink); color: var(--on-ink-strong); font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h4); }
  .plugin-install { margin: 0; display: grid; gap: var(--space-1); min-inline-size: 0; }
  .plugin-install-label { font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle); }
  .plugin-install code { display: block; padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); background: var(--surface-sunken); border: 1px solid var(--border-subtle); font-family: var(--font-mono); font-size: var(--text-mono); line-height: var(--leading-mono); color: var(--text-strong); overflow-wrap: anywhere; }
</style>
