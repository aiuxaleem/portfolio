---
/* One of the owner's skills on My Claude Skills (/skills, L-63), shown so a visitor can use it without reading anything
   else: what it does and gives back, the words to say that start it (from its SKILL.md trigger list), what it needs, and
   beside that the download with its size, the SKILL.md to read first, and the three steps for Claude.ai and for Claude
   Code with the folder name filled in. A skill shown through its case study has that link in place of the download.
   States: with a download, through a case study only, without prompts or needs (the parts are left out). */
import Button from '../ui/button.astro';
import CodeBlock from '../content/code-block.astro';
import { type Skill, skillCategoryLabel } from '../../lib/skills';

interface Props { skill: Skill; id: string }
const { skill, id } = Astro.props;
const d = skill.data;
const prompts = d.prompts ?? [], needs = d.needs ?? [];
const letter = d.title.trim().charAt(0).toUpperCase();
const down = '<svg slot="icon-left" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>';
const arrow = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"></path></svg>';
---
<article class="skill-show" aria-labelledby={`${id}-title`}>
  <div class="skill-show-about">
    <div class="skill-show-head">
      <span class="skill-show-mark" aria-hidden="true">{letter}</span>
      <div class="skill-show-name">
        <h3 id={`${id}-title`}>{d.title}</h3>
        <p class="case-kicker"><bdi>{d.name}</bdi>{' · '}{skillCategoryLabel[d.category]}</p>
      </div>
    </div>
    <p class="skill-show-summary">{d.summary}</p>
    {d.gives && <div class="skill-show-part"><h4>What you get</h4><p>{d.gives}</p></div>}
    {prompts.length > 0 && (
      <div class="skill-show-part">
        <h4>Say this to start it</h4>
        <ul class="skill-show-prompts">{prompts.map(t => <li><q>{t}</q></li>)}</ul>
      </div>
    )}
    {needs.length > 0 && <div class="skill-show-part"><h4>What it needs</h4><ul class="skill-show-needs">{needs.map(t => <li>{t}</li>)}</ul></div>}
    {d.note && <p class="skill-show-note">{d.note}</p>}
  </div>
  <div class="skill-show-use">
    {d.download
      ? <>
          <div class="skill-show-get">
            <Button variant="primary" href={d.download} download={`${d.name}.zip`}><Fragment set:html={down} />Download<span class="cory-visually-hidden"> {d.title}, a zip file{d.size && <>, {d.size}</>}</span></Button>
            <span class="skill-show-size" aria-hidden="true">.zip{d.size && <>{' · '}{d.size}</>}</span>
          </div>
          {d.readme && <a class="skill-show-link" href={d.readme} target="_blank" rel="noopener">Read the SKILL.md first<span class="cory-visually-hidden">: {d.title} (opens in a new tab)</span> <Fragment set:html={arrow} /></a>}
          <div class="skill-show-steps">
            <h4>In Claude.ai</h4>
            <ol><li>Keep the zip as it is.</li><li>Customize &gt; Skills, then + and Upload a skill.</li><li>Switch it on and say one of the lines shown here.</li></ol>
          </div>
          <div class="skill-show-steps">
            <h4>In Claude Code</h4>
            <ol><li>Unzip it into your skills folder:</li></ol>
            <CodeBlock><code>{`~/.claude/skills/${d.name}/SKILL.md`}</code></CodeBlock>
            <ol start="2"><li>Start a new session and ask, or type <code dir="ltr">/{d.name}</code>.</li></ol>
          </div>
        </>
      : d.caseStudy
        ? <div class="skill-show-steps"><h4>How it was used</h4><p>This one was built for a client's own system, so it is not offered as a download. The case study shows what it did and how.</p><Button variant="secondary" href={d.caseStudy}>Read the case study<span class="cory-visually-hidden"> about {d.title}</span></Button></div>
        : <p class="skill-show-note">The download is coming soon.</p>}
  </div>
</article>

<style>
  .skill-show { display: grid; gap: var(--space-8); padding: var(--space-6); border-radius: var(--radius-xl); background: var(--surface-card); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); min-inline-size: 0; }
  @container (min-width: 820px) { .skill-show { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); padding: var(--space-8); } }
  .skill-show-about, .skill-show-use { display: grid; gap: var(--space-5); align-content: start; min-inline-size: 0; }
  .skill-show-use { padding: var(--space-5); border-radius: var(--radius-lg); background: var(--surface-sunken); border: 1px solid var(--border-subtle); }
  .skill-show-head { display: flex; align-items: center; gap: var(--space-3); min-inline-size: 0; }
  .skill-show-mark { flex-shrink: 0; display: grid; place-items: center; inline-size: var(--tap-target); block-size: var(--tap-target); border-radius: var(--radius-md); background: var(--gradient-ink); color: var(--on-ink-strong); font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h4); }
  .skill-show-name { display: grid; gap: 2px; min-inline-size: 0; }
  .skill-show-name h3 { margin: 0; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h3); line-height: var(--leading-heading); color: var(--text-strong); overflow-wrap: anywhere; }
  .skill-show-name .case-kicker { overflow-wrap: anywhere; }
  .skill-show-summary { margin: 0; font-size: var(--text-body-lg); line-height: var(--leading-relaxed); color: var(--text-body); max-inline-size: var(--measure-body); }
  .skill-show-part { display: grid; gap: var(--space-2); }
  .skill-show h4 { margin: 0; font-size: var(--text-caption); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-subtle); }
  .skill-show-part > p { margin: 0; line-height: var(--leading-relaxed); color: var(--text-body); max-inline-size: var(--measure-body); }
  .skill-show-prompts { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .skill-show-prompts q { display: inline-block; padding: var(--space-2) var(--space-3); border-radius: var(--radius-pill); background: var(--action-ghost-hover); color: var(--text-link); font-weight: var(--weight-semibold); font-size: var(--text-body-sm); quotes: '\201C' '\201D'; overflow-wrap: anywhere; }
  .skill-show-needs { margin: 0; padding-inline-start: var(--space-5); display: grid; gap: var(--space-1); list-style: disc; color: var(--text-body); line-height: var(--leading-relaxed); }
  .skill-show-note { margin: 0; padding-inline-start: var(--space-3); border-inline-start: 2px solid var(--border-default); font-size: var(--text-body-sm); line-height: var(--leading-relaxed); color: var(--text-muted); }
  .skill-show-get { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .skill-show-size { font-family: var(--font-mono); font-size: var(--text-mono); color: var(--text-muted); white-space: nowrap; }
  .skill-show-link { display: inline-flex; align-items: center; gap: var(--space-1); inline-size: fit-content; min-block-size: var(--tap-target); font-size: var(--text-body-sm); font-weight: var(--weight-semibold); color: var(--text-link); text-decoration: none; }
  @media (hover: hover) { .skill-show-link:hover { text-decoration: underline; text-underline-offset: 3px; } }
  .skill-show-link:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
  .skill-show-steps { display: grid; gap: var(--space-2); min-inline-size: 0; }
  .skill-show-steps ol { margin: 0; padding-inline-start: var(--space-6); display: grid; gap: var(--space-1); list-style: decimal; color: var(--text-body); line-height: var(--leading-relaxed); overflow-wrap: anywhere; }
  .skill-show-steps ol li::marker { font-family: var(--font-mono); font-size: var(--text-mono); color: var(--text-subtle); }
  .skill-show-steps p { margin: 0; line-height: var(--leading-relaxed); color: var(--text-body); }
  .skill-show-steps code { font-family: var(--font-mono); font-size: var(--text-mono); }
</style>
