---
/* A link to a picture's full size around its rendering, for pictures drawn with <Image> directly (a case study's figures):
   the preview dialog opens it (islands/image-preview.ts, ui/image-preview.astro); without JavaScript the link opens the
   file (owner request, 9 November 2026, L-60). The link fills its frame (components.css, .image-preview-link). */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src: ImageMetadata; alt: string; caption?: string }
const { src, alt, caption } = Astro.props;
const full = await getImage({ src, width: Math.min(src.width, 2000) });
---
<a class="image-preview-link" data-preview href={full.src} data-caption={caption} target="_blank" rel="noopener" aria-label={`View larger: ${alt || caption || 'picture'}`}><slot /></a>
