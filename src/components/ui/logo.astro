---
/* The Aleem logo (owner's logo system, 20 November 2026, L-84; replaces the 12 November kit's "a" tile, L-67): a rounded
   navy tile holding AIUX on a two-by-two grid (AI above UX, both rows justified to one width), the I alone in the
   blue-to-cyan gradient, top to bottom, and the "Aleem" wordmark beside it. The shapes are the design system's own outlines
   (Aleem-Brand-Kit/Aleem-Brand-Kit/01-Logo/SVG/aleem-logo.svg, from project/assets/Logo/ of the Aleem Design System), never
   retyped in a font; only the colours come from tokens, so one drawing serves the light page, the dark page (a navy-700
   tile, a white wordmark) and the ink panels (`onInk`: a white tile with navy letters beside the white wordmark).
   `mark` draws the tile alone. The accessible name is "Aleem AIUX", as the logo system names it.
   Minimum sizes from the logo system: the mark 24px (below that the favicon file), the logo 20px tall. */
import { nextId } from '../../lib/ids';
interface Props { /** 'logo' (tile and wordmark) or 'mark' (the tile alone). */ variant?: 'logo' | 'mark'; /** Height in px. */ size?: number; /** On an ink panel: the dark-ground colours whatever the theme. */ onInk?: boolean; /** Decorative where words beside it already name the brand. */ decorative?: boolean; class?: string }
const { variant = 'logo', size = 28, onInk = false, decorative = false, class: className } = Astro.props;
const vbW = 406.809, vbH = 120;
const width = variant === 'mark' ? vbH : vbW;
/* One gradient id per drawing: a page shows the logo more than once. */
const id = nextId('aleem-signal');
---
<svg class:list={['aleem-logo', className]} data-on-ink={onInk ? '' : undefined} xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${width} ${vbH}`} height={size} width={Math.round((size * width) / vbH)} {...(decorative ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': 'Aleem AIUX' })} focusable="false">
  <defs><linearGradient id={id} x1="0" y1="0" x2="0" y2="1"><stop offset="0" style="stop-color: var(--blue-500)" /><stop offset="1" style="stop-color: var(--cyan-500)" /></linearGradient></defs>
  <path class="aleem-logo-tile" d="M27.27 0H92.73A27.27 27.27 0 0 1 120 27.27V92.73A27.27 27.27 0 0 1 92.73 120H27.27A27.27 27.27 0 0 1 0 92.73V27.27A27.27 27.27 0 0 1 27.27 0Z" />
  <path class="aleem-logo-letter" d="M49.154 24H57.01L42.851 55.95H34.994ZM51.039 24H58.896L73.055 55.95H65.199ZM43.368 44.448H64.682V50.658H43.368ZM34.994 64.05H41.744V85H34.994ZM56.994 85A11 11 0 0 1 34.994 85H41.744A4.25 4.25 0 0 0 50.244 85ZM50.244 64.05H56.994V85H50.244ZM77.541 64.05H85.006L69.659 96H62.194ZM62.194 64.05H69.659L85.006 96H77.541Z" />
  <path d="M78.256 24H85.006V55.95H78.256Z" fill={`url(#${id})`} />
  {variant === 'logo' && <path class="aleem-logo-word" d="M167.661 26.4H179.112L155.45 93.6H144ZM170.41 26.4H181.86L205.521 93.6H194.071ZM157.535 69.408H191.986V78.986H157.535ZM212.497 26.4H222.908V93.6H212.497ZM273.546 85.147A23.662 23.662 0 1 1 279.081 69.938L268.67 69.938A13.251 13.251 0 1 0 265.57 78.455L273.546 85.147ZM236.963 64.732H279.081V75.144H236.963ZM327.116 85.147A23.662 23.662 0 1 1 332.652 69.938L322.241 69.938A13.251 13.251 0 1 0 319.141 78.455L327.116 85.147ZM290.534 64.732H332.652V75.144H290.534ZM341.502 65.206H351.913V93.6H341.502ZM341.502 65.206A18.93 18.93 0 0 1 379.361 65.206H368.95A8.518 8.518 0 0 0 351.913 65.206ZM368.95 65.206H379.361V93.6H368.95ZM368.95 65.206A18.93 18.93 0 0 1 406.809 65.206H396.398A8.518 8.518 0 0 0 379.361 65.206ZM396.398 65.206H406.809V93.6H396.398Z" />}
</svg>

<style is:global>
  .aleem-logo { display: block; flex-shrink: 0; max-inline-size: 100%; block-size: auto; }
  .aleem-logo .aleem-logo-tile { fill: var(--logo-tile); }
  .aleem-logo .aleem-logo-letter { fill: var(--logo-letter); }
  .aleem-logo .aleem-logo-word { fill: var(--logo-word); }
  .aleem-logo[data-on-ink] .aleem-logo-tile { fill: var(--logo-tile-on-ink); }
  .aleem-logo[data-on-ink] .aleem-logo-letter { fill: var(--logo-letter-on-ink); }
  .aleem-logo[data-on-ink] .aleem-logo-word { fill: var(--logo-word-on-ink); }
  @media (forced-colors: active) { .aleem-logo .aleem-logo-word { fill: CanvasText; } }
</style>
