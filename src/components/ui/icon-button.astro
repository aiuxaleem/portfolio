---
/* Icon-only button. Always needs a label: it becomes the accessible name and the tooltip. */
interface Props { label: string; variant?: 'secondary' | 'ghost'; [key: string]: unknown }
const { label, variant = 'secondary', ...rest } = Astro.props;
---
<button type="button" class:list={['ui-icon-button', `ui-icon-button-${variant}`]} aria-label={label} title={label} {...rest}><slot /></button>

<style is:global>
  .ui-icon-button { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: var(--radius-pill); cursor: pointer; font-size: 20px; line-height: 1; padding: 0; border: 1px solid transparent; transition: background var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out), filter var(--duration-base) var(--ease-out); }
  .ui-icon-button-ghost { background: transparent; color: var(--text-body); }
  .ui-icon-button-secondary { background: var(--surface-card); color: var(--text-strong); border-color: var(--border-interactive); box-shadow: var(--shadow-xs); }
  @media (hover: hover) {
    .ui-icon-button:hover { transform: translateY(-1px); }
    .ui-icon-button-ghost:hover { background: var(--action-ghost-hover); color: var(--text-link); }
    .ui-icon-button-secondary:hover { background: var(--action-secondary-hover); }
  }
</style>
