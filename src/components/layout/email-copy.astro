---
/* Email link with a copy button. States: idle, copied, clipboard blocked (the address is selected and a hint is shown). */
import { site } from '../../content/site';
interface Props { copyLabel: string; copiedLabel: string; fallbackLabel: string; subject?: string; statusText?: string }
const { copyLabel, copiedLabel, fallbackLabel, subject, statusText = '' } = Astro.props;
const href = 'mailto:' + site.email + (subject ? '?subject=' + encodeURIComponent(subject) : '');
---
<span data-email-copy data-copied={copiedLabel} data-fallback={fallbackLabel} style="display: inline-flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; color: inherit;">
  <a data-email data-link href={href} lang="en" dir="ltr" style="display: inline-flex; align-items: center; min-block-size: var(--tap-target); font-weight: var(--weight-semibold); color: inherit; text-decoration: none; overflow-wrap: anywhere;">{site.email}</a>
  <button type="button" aria-label={copyLabel} title={copyLabel} class="email-copy-button" style="display: inline-grid; place-items: center; inline-size: var(--tap-target); block-size: var(--tap-target); border: 0px; border-radius: var(--radius-pill); background: transparent; color: inherit; cursor: pointer; transition: background var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out);">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
  </button>
  <span role="status" aria-live="polite" style="font-size: var(--text-caption); color: inherit;">{statusText}</span>
</span>

<style is:global>
  .email-copy-button:active { transform: scale(var(--press-scale)) !important; }
  @media (hover: hover) { .email-copy-button:hover { background: color-mix(in srgb, currentcolor 12%, transparent 88%) !important; } }
</style>
