---
/* Home. Nine sections follow the owner's design in Claude Design (design/claude-design/AIUXAleem Home.dc.html) with their
   markup intact (hero, teams worked with, point of view, beyond the canvas, skills, in public, now, the services teaser, the closing panel), wired to site settings, the profile file and the case studies
   collection. Projects come from the collection. Writing and videos are in the design's In public section, which links to /read and /videos, so Home does not list them a second time.
   The design's own Projects section is not here: the projects on Home are the ones in the collection. */
import BaseLayout from '../layouts/base-layout.astro';
import SiteHeader from '../components/layout/site-header.astro';
import SiteFooter from '../components/layout/site-footer.astro';
import Atmosphere from '../components/home/atmosphere.astro';
import Hero from '../components/home/hero.astro';
import WorkedWith from '../components/home/worked-with.astro';
import PointOfView from '../components/home/point-of-view.astro';
import BeyondTheCanvas from '../components/home/beyond-the-canvas.astro';
import Skills from '../components/home/skills.astro';
import DesignSection from '../components/home/design-section.astro';
import HomeFeeds from '../components/home/home-feeds.astro';
import ServicesTeaser from '../components/home/services-teaser.astro';
import Closing from '../components/home/closing.astro';
import { site } from '../content/site';
import { profile } from '../content/profile';
import { personLd, websiteLd } from '../lib/seo';
---
<BaseLayout title={`${site.brand} · ${profile.headline}`} description={site.positioning} page="home" langs="en ar" jsonLd={[personLd(), websiteLd()]}>
  <div id="dc-root">
    <div class="sc-host">
      <div class="sc-host" data-sc-name="Site Header"><SiteHeader lang="en" langs="en ar" /></div>
      <Atmosphere />
      <main id="main" data-page="home" tabindex="-1" style="position: relative; z-index: var(--z-raised); outline: none;">
        <Hero />
        <WorkedWith />
        <PointOfView />
        <BeyondTheCanvas />
        <Skills />
        <HomeFeeds show={['projects']} />
        <DesignSection name="content" />
        <DesignSection name="now" />
        <ServicesTeaser />
        <Closing />
      </main>
      <div class="sc-host" data-sc-name="Site Footer"><SiteFooter lang="en" hideCta /></div>
    </div>
  </div>
  <script>
    import '../components/islands/page-behaviours.ts';
  </script>
</BaseLayout>
