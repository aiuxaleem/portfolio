---
/* Version 2 of Home (the A/B test, docs/AB_TEST.md). Version 1's Home with one addition: the two doors under the teams
   strip, so a hiring manager and a client each take the page written for them. Kept out of search (its canonical is
   Home); visits are still counted, as /v2. */
import BaseLayout from '../../layouts/base-layout.astro';
import SiteHeader from '../../components/layout/site-header.astro';
import SiteFooter from '../../components/layout/site-footer.astro';
import Atmosphere from '../../components/home/atmosphere.astro';
import Hero from '../../components/home/hero.astro';
import WorkedWith from '../../components/home/worked-with.astro';
import BeyondTheCanvas from '../../components/home/beyond-the-canvas.astro';
import Skills from '../../components/home/skills.astro';
import DesignSection from '../../components/home/design-section.astro';
import HomeFeeds from '../../components/home/home-feeds.astro';
import ServicesTeaser from '../../components/home/services-teaser.astro';
import Closing from '../../components/home/closing.astro';
import AudienceFork from '../../components/v2/audience-fork.astro';
import { site } from '../../content/site';
import { profile } from '../../content/profile';
import { personLd, websiteLd } from '../../lib/seo';
---
<BaseLayout ab canonical={new URL('/', Astro.site).href} title={`${site.brand} · ${profile.headline}`} description={site.positioning} page="home" jsonLd={[personLd(), websiteLd()]}>
  <div id="dc-root">
    <div class="sc-host">
      <div class="sc-host" data-sc-name="Site Header"><SiteHeader lang="en" langs="en ar" /></div>
      <Atmosphere />
      <main id="main" data-page="home" tabindex="-1" style="position: relative; z-index: var(--z-raised); outline: none;">
        <Hero />
        <WorkedWith />
        <section id="doors" data-section class="cory-container" aria-labelledby="doors-title" style="display: grid; gap: var(--space-8); padding-block: var(--section-y) 0;">
          <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Two ways in</p><h2 id="doors-title" class="page-h2">Hiring, or building?</h2><p class="project-filter-count" style="max-inline-size: var(--measure-lead);">Pick the page written for you. Both lead to the same work.</p></div>
          <AudienceFork id="home-doors" />
        </section>
        <HomeFeeds show={['projects']} />
        <DesignSection name="about" />
        <BeyondTheCanvas />
        <Skills />
        <DesignSection name="content" />
        <DesignSection name="now" />
        <ServicesTeaser />
        <Closing />
      </main>
      <div class="sc-host" data-sc-name="Site Footer"><SiteFooter lang="en" hideCta /></div>
    </div>
  </div>
  <script>
    import '../../components/islands/page-behaviours.ts';
  </script>
</BaseLayout>
