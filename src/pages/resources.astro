---
/* /resources, the UX Glossary ("Resources" in the header, beside AI Tools): a curated directory of tools, references
   and reading for AI product design, led by my own AI workflows, Claude skills and artifacts when there are any.
   Originally: a curated directory of tools, references and reading for AI product design. Every entry is a file in
   src/content/resources/ and links out to its own site. The page: who it is for and three counts; the categories, each
   linking to the list filtered to it; the list with filters and a sort order; and a form to suggest a resource, which
   goes to the owner for review. The form is offered only where /api/resources exists (the Vercel build and dev); the
   static copies offer email instead. */
import PageLayout from '../layouts/page-layout.astro';
import Button from '../components/ui/button.astro';
import ResourceCard from '../components/cards/resource-card.astro';
import ResourceFilters from '../components/resources/resource-filters.astro';
import SuggestForm from '../components/resources/suggest-form.astro';
import CategoryBento from '../components/resources/category-bento.astro';
import CategoryIcon from '../components/resources/category-icon.astro';
import { listedResources, categoryCounts, madeByMe } from '../lib/resources';
import { listedAiTools } from '../lib/ai-tools';
import { site } from '../content/site';
import { profile } from '../content/profile';
import { day } from '../lib/projects';

const resources = await listedResources();
const real = resources; // the same list the filters count, so every number on the page agrees (fixtures are listed only in dev and quality builds)
const categories = categoryCounts(resources);
const filled = categories.filter(c => c.count > 0);
const mine = madeByMe(resources);
const aiToolCount = (await listedAiTools()).filter(t => !t.data.fixture).length;
const counts = ([[filled.length, 'categories'], [real.length, 'resources'], [mine.length, 'made by me']] as const).filter(([n]) => n > 0);
const canSuggest = import.meta.env.COUNT_VISITS === '1';
const notes = [
  { id: 'suggest-sent', ok: true, title: 'Suggestion received.', body: 'Thank you. I look at every suggestion before it goes on the page, so it will not appear straight away.' },
  { id: 'suggest-refused', ok: false, title: 'The suggestion was not accepted.', body: 'The name, a full link starting with https:// and a category are needed. Fill them in and send it again.' },
  { id: 'suggest-later', ok: false, title: 'That is enough for one hour.', body: 'Five suggestions from one place within an hour is the limit. Thank you; send the rest later or by email.' },
  { id: 'suggest-failed', ok: false, title: 'The suggestion was not saved.', body: 'The site could not save it. Nothing was kept. Try again in a minute, or send it by email.' },
];
/* The hero panel: the counts, and the six fullest categories as a way in. "Updated" is the newest entry's date. */
const fullest = [...filled].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label)).slice(0, 6);
const updated = real.length ? real.reduce((d, r) => (r.data.added > d ? r.data.added : d), real[0].data.added) : undefined;
const stat = 'margin: 0; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-h2); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--on-ink-strong); font-variant-numeric: tabular-nums;';
const inkLink = 'display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-block-size: var(--tap-target); padding-block: var(--space-2); color: var(--on-ink-strong); text-decoration: none; font-weight: var(--weight-semibold); font-size: var(--text-body-md); border-block-start: 1px solid var(--on-ink-border);';
---
<PageLayout title="UX Glossary · AIUXAleem" description="Tools, references and reading for AI product design, design systems and accessibility, plus my own AI workflows and Claude skills." page="resources" bg="grid" mainStyle="outline: none; overflow: clip;">
  <section aria-labelledby="resources-title" style="position: relative; padding-block: var(--section-y) var(--space-10); overflow: clip;">
    <div class="cory-container cory-split" style="align-items: center;">
      <div style="display: grid; gap: var(--space-6); align-content: center;">
        <p class="cory-overline" style="margin: 0px;">Resources · UX Glossary</p>
        <h1 id="resources-title" style="margin: 0px; max-inline-size: 16ch; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-display); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--text-strong); text-wrap: balance;">The UX glossary for AI product design.</h1>
        <p style="margin: 0px; max-inline-size: var(--measure-lead); font-size: var(--text-fluid-lead); line-height: var(--leading-relaxed); color: var(--text-muted);">The tools, references and reading I use in design system and AI product work, each with a line on why it earns its place. Every entry opens on its own site.</p>
        <p class="case-kicker">Kept by <bdi>{site.name}</bdi>, {profile.headline}{updated && <Fragment> · Updated <time datetime={updated.toISOString().slice(0, 10)}>{day(updated)}</time></Fragment>}</p>
        <div data-hero-ctas style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;">
          <Button variant="primary" size="lg" href="#categories">Browse by category</Button>
          <Button variant="secondary" size="lg" href="#suggest">Suggest a resource</Button>
        </div>
      </div>
      {real.length > 0 && (
        <div class="project-cta" aria-labelledby="library-title" role="region" style="padding: var(--space-8); display: grid; gap: var(--space-6); box-shadow: var(--shadow-md);">
          <div style="display: grid; gap: var(--space-2);">
            <p class="cory-overline" style="margin: 0; color: var(--on-ink-link);">In the library</p>
            <h2 id="library-title" style="margin: 0; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h3); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--on-ink-strong);">What is here today</h2>
          </div>
          <ul aria-label="Counts" style="display: flex; flex-wrap: wrap; gap: var(--space-5) var(--space-8);">
            {counts.map(([n, label]) => <li style="display: grid; gap: var(--space-1);"><strong style={stat}>{n}</strong><span style="font-size: var(--text-body-sm); color: var(--on-ink-muted);">{label}</span></li>)}
          </ul>
          <div style="display: grid; gap: 0;">
            <p style="margin: 0 0 var(--space-2); font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--on-ink-muted);">Fullest categories</p>
            <ul aria-label="Fullest categories">
              {fullest.map(c => <li><a class="ink-row" href={`/resources?category=${c.slug}#resources-list`} style={inkLink}><span style="display: inline-flex; align-items: center; gap: var(--space-3); min-inline-size: 0;"><CategoryIcon category={c.slug} size={18} style="flex-shrink: 0; color: var(--on-ink-link);" /><span style="min-inline-size: 0; overflow-wrap: anywhere;">{c.label}</span></span><span style="display: inline-flex; align-items: center; gap: var(--space-2); flex-shrink: 0; font-family: var(--font-mono); font-size: var(--text-mono-sm); color: var(--on-ink-muted); font-variant-numeric: tabular-nums;">{c.count}<svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--on-ink-link);"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></span></a></li>)}
            </ul>
          </div>
          {aiToolCount > 0 && (
            <a class="ink-row" href="/ai-tools" style={inkLink + ' border-block-start: 1px solid var(--on-ink-border); padding-block-start: var(--space-4);'}><span style="display: grid; gap: 2px; min-inline-size: 0;"><span>AI Tools</span><span style="font-size: var(--text-caption); font-weight: var(--weight-regular); color: var(--on-ink-muted);">{aiToolCount} AI tools, by what they help you do</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: none;"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          )}
        </div>
      )}
    </div>
  </section>

  {real.length === 0 && (
    <section class="cory-container" aria-label="Nothing listed" style="padding-block-end: var(--section-y);"><div class="project-empty"><p class="project-empty-title">Nothing is listed yet.</p><p class="project-empty-body">Resources are added as they earn a place. Until then, the AI Tools directory lists the AI tools worth knowing.</p><div><Button variant="secondary" href="/ai-tools">Open AI Tools</Button></div></div></section>
  )}

  {mine.length > 0 && (
    <section id="made-by-me" class="page-section paged-section" aria-labelledby="mine-title">
      <div class="cory-container">
        <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Made by me</p><h2 id="mine-title" class="page-h2">My AI workflows, skills and artifacts</h2><p class="project-filter-count" style="max-inline-size: var(--measure-lead);">Things I built for my own design work and use every week. Each opens where it lives, to read or to copy.</p></div>
        <div data-cq><ul data-cq-balance style="display: grid; gap: var(--grid-gap);">{mine.map(r => <li><ResourceCard resource={r} level={3} /></li>)}</ul></div>
      </div>
    </section>
  )}

  {filled.length > 0 && (
    <section id="categories" class="page-section paged-section" data-surface="card" aria-labelledby="categories-title">
      <div class="cory-container">
        <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Browse</p><h2 id="categories-title" class="page-h2">By category</h2><p class="project-filter-count">The fullest categories are the wide tiles. Each tile opens the list below, filtered to it.</p></div>
        <CategoryBento categories={categories} />
      </div>
    </section>
  )}

  {resources.length > 0 && (
    <section id="resources-list" class="page-section paged-section" aria-labelledby="list-title">
      <div class="cory-container">
        <div class="page-section-head"><p class="cory-overline" style="margin: 0;">All resources</p><h2 id="list-title" class="page-h2">Filter and sort</h2><p class="project-filter-count">Each card opens the resource on its own site, in a new tab.</p></div>
        <ResourceFilters resources={resources} />
        <div data-cq><ul data-resource-list data-cq-balance style="display: grid; gap: var(--grid-gap);">{resources.map(r => <li><ResourceCard resource={r} level={3} /></li>)}</ul></div>
        <p data-resource-more hidden style="margin: var(--space-6) 0 0;"><Button variant="secondary" data-show-more>Show more</Button></p>
      </div>
    </section>
  )}

  <section id="suggest" class="page-section paged-section" data-surface="card" aria-labelledby="suggest-heading">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Missing something?</p><h2 id="suggest-heading" class="page-h2">Know a resource I should list?</h2><p class="project-filter-count" style="max-inline-size: var(--measure-lead);">Send it over. I look at every suggestion before it goes on the page, and I only list what I would use myself.</p></div>
      {/* Where the form was sent without JavaScript, the site sends the visitor back to one of these notes. */}
      {canSuggest && notes.map(n => (
        <div id={n.id} class:list={['form-panel', n.ok && 'form-success']} data-target-note tabindex="-1">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d={n.ok ? 'm8.5 12.5 2.5 2.5 4.5-5' : 'M12 8v4M12 16h.01'}></path></svg>
          <div><p class="form-panel-title">{n.title}</p><p>{n.body}</p></div>
        </div>
      ))}
      {canSuggest
        ? <SuggestForm email={site.email} />
        : <div class="project-empty" style="max-inline-size: var(--measure-lead);"><p class="project-empty-title">Suggest it by email.</p><p class="project-empty-body">This copy of the site cannot take suggestions directly. Send the name and the link to {site.email} and I will take a look.</p><div><Button variant="secondary" href={`mailto:${site.email}?subject=${encodeURIComponent('Resource suggestion')}`}>Email a suggestion</Button></div></div>}
    </div>
  </section>
  <style is:global>
    .ink-row:focus-visible { outline: var(--border-width-strong) solid var(--on-ink-link); outline-offset: 2px; border-radius: var(--radius-xs); }
    @media (hover: hover) { .ink-row:hover { color: var(--on-ink-link) !important; } }
  </style>
  <script>
    import '../components/islands/resource-list.ts';
  </script>
</PageLayout>
