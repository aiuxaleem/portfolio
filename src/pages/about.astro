---
/* /about: positioning, then work experience (with what each role shipped) and certifications (the ones in progress first,
   on an ink panel), then principles, expertise, how I work with AI, tools, testimonials, and the contact block with the
   form at the end.
   Copy and facts come from src/content/site/profile.json; certifications from the certifications collection.
   Section backgrounds alternate between the page and card surfaces. */
import PageLayout from '../layouts/page-layout.astro';
import DesignSection from '../components/home/design-section.astro';
import ContactBlock from '../components/profile/contact-block.astro';
import { getCollection } from 'astro:content';
import Career from '../components/profile/career.astro';
import Certifications from '../components/profile/certifications.astro';
import Testimonials from '../components/profile/testimonials.astro';
import { profile } from '../content/profile';
import { personLd } from '../lib/seo';
/* Certifications in progress lead the Learning section on an ink panel; the earned ones follow as the usual list. */
const certs = (await getCollection('certifications', ({ data }) => !data.draft && !data.fixture)).sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));
const studying = certs.filter(c => c.data.status === 'in-progress');
const earned = certs.length - studying.length;
const completed = certs.filter(c => c.data.status === 'completed').length;
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<PageLayout title="About · AIUXAleem" description="About Mohammad Abdul Aleem, Lead AI Product Designer in Hyderabad: career, expertise, how he works with AI, tools and certifications." page="about" ogType="profile" jsonLd={[personLd()]} hideCta bg="grid" mainStyle="outline: none; overflow: clip;">
  <DesignSection name="about-hero" />

  <section class="page-section" aria-labelledby="career-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Work experience</p><h2 id="career-title" class="page-h2">Enterprise UX to AI product design</h2><p class="project-filter-count" style="max-inline-size: var(--measure-lead);">Newest first, with what each role shipped.</p></div>
      <Career wide />
      <a data-link class="post-back" href="/resume"><span>Full detail is in the resume</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
    </div>
  </section>

  <DesignSection name="about-direction" />

  <section class="page-section" data-surface="card" aria-labelledby="certs-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Learning</p><h2 id="certs-title" class="page-h2">Certifications</h2>{earned > 0 && <p class="project-filter-count">{earned} earned{studying.length > 0 && `, ${studying.length} in progress`}.</p>}</div>
      {studying.length > 0 && (
        <div class="project-cta about-studying" role="region" aria-labelledby="studying-title">
          <div style="display: grid; gap: var(--space-2);">
            <p class="cory-overline" style="margin: 0; color: var(--on-ink-link);">In progress now</p>
            <h3 id="studying-title" class="about-studying-title">What I am studying</h3>
          </div>
          <ul class="about-studying-list">
            {studying.map(({ data: c }) => <li><span class="about-studying-name">{c.name}</span><span class="about-studying-meta">{[c.issuer, c.issued].filter(Boolean).join(' · ')}</span></li>)}
          </ul>
          <a data-link class="post-back about-studying-link" href="/now"><span>More on what I am learning now</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
        </div>
      )}
      <div class="about-verified"><Certifications only={['verified']} /></div>
      {completed > 0 && (
        <details class="resource-disclosure about-courses">
          <summary><span class="project-filter-label" style="flex-basis: auto; margin: 0;">Courses completed</span><span data-disclosure-state>{completed}</span><svg data-chevron width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
          <div class="about-courses-body"><Certifications only={['completed']} compact /></div>
        </details>
      )}
    </div>
  </section>

  <section class="page-section" aria-labelledby="principles-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Principles</p><h2 id="principles-title" class="page-h2">Three things I won't trade away</h2></div>
      <div data-cq><ol data-cq-balance style="display: grid; gap: var(--grid-gap);">{profile.principles.map((p, i) => <li><div class="tile"><bdi class="tile-num" aria-hidden="true">{num(i)}</bdi><h3>{p.title}</h3><p>{p.body}</p></div></li>)}</ol></div>
    </div>
  </section>

  <section class="page-section" data-surface="card" aria-labelledby="expertise-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Expertise</p><h2 id="expertise-title" class="page-h2">What I bring to a product team</h2></div>
      <div data-cq><ul data-cq-balance style="display: grid; gap: var(--grid-gap);">{profile.expertise.map(e => <li><div class="tile"><h3>{e.title}</h3><p>{e.body}</p></div></li>)}</ul></div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="ai-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Method</p><h2 id="ai-title" class="page-h2">How I work with AI</h2></div>
      <div data-cq><ol data-cq-grid style="display: grid; gap: var(--grid-gap);">{profile.aiWorkflow.map((s, i) => <li><div class="tile"><bdi class="tile-num" aria-hidden="true">{num(i)}</bdi><h3>{s.title}</h3><p>{s.body}</p></div></li>)}</ol></div>
      <div style="display: grid; gap: var(--space-3);">
        <h3 style="margin: 0; font-size: var(--text-h4); font-weight: var(--weight-bold); color: var(--text-strong);">Tools</h3>
        <ul class="tool-list">{profile.tools.map(t => <li><span class="ui-badge">{t}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <Testimonials />

  <ContactBlock id="contact" overline="Say hello" title="Hiring, or building something that needs to feel trustworthy?" lead="Send a message below, or book a 15-minute call. I reply within 48 hours." />
</PageLayout>

<style>
  .about-studying { display: grid; gap: var(--space-5); padding: var(--space-8); margin-block-end: var(--space-8); box-shadow: var(--shadow-md); }
  .about-studying-title { margin: 0; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h3); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--on-ink-strong); }
  .about-studying-list { display: grid; gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  @media (min-width: 768px) { .about-studying-list { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); } }
  .about-studying-list li { display: grid; gap: var(--space-1); padding-block-start: var(--space-4); border-block-start: 1px solid var(--on-ink-border); min-inline-size: 0; }
  .about-studying-name { font-size: var(--text-body-lg); font-weight: var(--weight-bold); color: var(--on-ink-strong); overflow-wrap: anywhere; }
  .about-studying-meta { font-size: var(--text-body-sm); color: var(--on-ink-muted); }
  .about-studying-link { color: var(--on-ink-link); }
  /* Verified certificates two to a row from about 880px, so four make two full rows. */
  .about-verified :global(.cert-list) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .about-courses { margin-block-start: var(--space-6); }
  .about-courses-body { padding: 0 var(--space-5) var(--space-5); }
</style>
