---
/* Case studies on the website for clients (docs/SITES.md): a first screen with the newest cases fanned beside the words,
   then every case as a bento, framed as proof of the work a team can bring me in for. The call is a scoping call. */
import PageLayout from '../../../layouts/page-layout.astro';
import SiteHero from '../../../components/sites/site-hero.astro';
import HeroStack from '../../../components/sites/hero-stack.astro';
import { moreCases } from '../../../lib/site-stacks';
import CaseGrid from '../../../components/sites/case-grid.astro';
import { site } from '../../../content/site';
import { chrome } from '../../../i18n/chrome';
const c = chrome.en;
const stack = await moreCases();
---
<PageLayout title="Case studies · AIUXAleem, for clients" description="Case studies by Mohammad Abdul Aleem for product teams: the problem, the constraints, the decisions and what shipped, in AI product design and design systems." page="case-studies" bg="grid" mainStyle="outline: none; overflow: clip;">
  <SiteHero id="clients-cases" overline="The proof" title="The work, and how it was decided." accent="decided" lead="Each case gives the problem, the constraints, the decisions with their trade-offs, and what shipped. If your problem looks like one of these, a 15-minute call is enough to scope it." primary={{ label: c.call, href: site.calendarUrl, newTab: true }} secondary={{ label: 'See the services', href: '/' }}>
    <HeroStack slot="art" id="cases-stack" label="Case studies" noun="case study" cards={stack} />
  </SiteHero>
  <CaseGrid />
</PageLayout>
