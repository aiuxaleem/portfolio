---
/* About on the website for clients (docs/SITES.md): who a team works with. The positioning, the principles, what I bring,
   how I work with AI and the tools, the verified certifications, then the contact block with the subject set to a project.
   No resume, no job search: those are on the website for hiring teams. */
import PageLayout from '../../layouts/page-layout.astro';
import Learning from '../../components/sites/learning.astro';
import ContactBlock from '../../components/profile/contact-block.astro';
import { site } from '../../content/site';
import { profile } from '../../content/profile';
import { personLd } from '../../lib/seo';
import { chrome } from '../../i18n/chrome';

const c = chrome.en;
const num = (i: number) => String(i + 1).padStart(2, '0');
import SiteHero from '../../components/sites/site-hero.astro';
import HeroStack from '../../components/sites/hero-stack.astro';
import { aboutCards } from '../../lib/site-stacks';
const stack = aboutCards({ method: '#clients-ai-title', principles: '#clients-principles-title', expertise: '#clients-expertise-title' });
---
<PageLayout title="About · AIUXAleem, for clients" description={`Who you work with: ${site.name}, ${profile.headline}. Principles, what he brings to a product team, and how he works with AI.`} page="about" hideCta bg="grid" mainStyle="outline: none; overflow: clip;" jsonLd={[personLd()]}>
  <SiteHero id="clients-about" overline="About" title="Who you'll work with." accent="work with" lead={`I'm ${site.name}, a ${profile.headline} with 13+ years across fintech and enterprise platforms, working from ${site.location} on GCC hours. ${profile.positioning}`} primary={{ label: c.call, href: site.calendarUrl, newTab: true }} secondary={{ label: 'See the case studies', href: '/case-studies' }}>
    <HeroStack slot="art" id="about-stack" label="About me" noun="card" cards={stack} />
  </SiteHero>

  <section class="page-section" data-surface="card" aria-labelledby="clients-principles-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Principles</p><h2 id="clients-principles-title" class="page-h2">Three things I won't trade away</h2></div>
      <div data-cq><ol data-cq-balance style="display: grid; gap: var(--grid-gap);">{profile.principles.map((p, i) => <li><div class="tile"><bdi class="tile-num" aria-hidden="true">{num(i)}</bdi><h3>{p.title}</h3><p>{p.body}</p></div></li>)}</ol></div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="clients-expertise-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Expertise</p><h2 id="clients-expertise-title" class="page-h2">What I bring to a product team</h2></div>
      <div data-cq><ul data-cq-balance style="display: grid; gap: var(--grid-gap);">{profile.expertise.map(e => <li><div class="tile"><h3>{e.title}</h3><p>{e.body}</p></div></li>)}</ul></div>
    </div>
  </section>

  <section class="page-section" data-surface="card" aria-labelledby="clients-ai-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Method</p><h2 id="clients-ai-title" class="page-h2">How I work with AI</h2></div>
      <div data-cq><ol data-cq-grid style="display: grid; gap: var(--grid-gap);">{profile.aiWorkflow.map((s, i) => <li><div class="tile"><bdi class="tile-num" aria-hidden="true">{num(i)}</bdi><h3>{s.title}</h3><p>{s.body}</p></div></li>)}</ol></div>
      <div style="display: grid; gap: var(--space-3);">
        <h3 style="margin: 0; font-size: var(--text-h4); font-weight: var(--weight-bold); color: var(--text-strong);">Tools</h3>
        <ul class="tool-list">{profile.tools.map(t => <li><span class="ui-badge">{t}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="clients-certs-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Learning</p><h2 id="clients-certs-title" class="page-h2">Certifications</h2></div>
      <Learning id="clients-learning" completed={false} />
    </div>
  </section>

  <ContactBlock id="contact" overline="Next step" title="Have a product that needs to feel trustworthy?" lead="Tell me what you're building, or book a 15-minute call to scope it. I reply within 48 hours." topic="project" />
</PageLayout>

