---
/* /writing: one feed of blog posts, LinkedIn articles and LinkedIn posts, newest first, with filters by type and topic.
   Without JavaScript the filters stay hidden and every item is listed. */
import PageLayout from '../layouts/page-layout.astro';
import FeedCard from '../components/cards/feed-card.astro';
import ProjectFilters from '../components/projects/project-filters.astro';
import Button from '../components/ui/button.astro';
import { feedItems, feedTags, feedTypes } from '../lib/writing';
import { site } from '../content/site';

const items = await feedItems();
const used = Object.fromEntries(Object.entries(feedTypes).filter(([type]) => items.some(i => i.type === type)));
---
<PageLayout title="Writing · AIUXAleem" description="Blog posts, LinkedIn articles and LinkedIn post series by Mohammad Abdul Aleem on AI product design, design systems and making AI trustworthy." page="writing" bg="grid" mainStyle="outline: none; overflow: clip;">
  <section class="cory-container" aria-labelledby="writing-title" style="position: relative; display: grid; gap: var(--space-6); padding-block: var(--section-y) var(--space-10);">
    <p class="cory-overline" style="margin: 0px;">Writing</p>
    <h1 id="writing-title" style="margin: 0px; max-inline-size: 16ch; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-display); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--text-strong);">Thinking out loud, in public.</h1>
    <p style="margin: 0px; max-inline-size: var(--measure-lead); font-size: var(--text-fluid-lead); line-height: var(--leading-relaxed); color: var(--text-muted);">Blog posts, LinkedIn articles and post series on AI product design, design systems and the craft of making AI trustworthy.</p>
    <div data-hero-ctas style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;">
      <Button variant="primary" size="lg" href={site.socials.linkedin} target="_blank" rel="noopener">Follow on LinkedIn<span class="cory-visually-hidden"> (opens in a new tab)</span></Button>
      <Button variant="secondary" size="lg" href="/blog">Read the blog</Button>
    </div>
  </section>
  <section class="cory-container" aria-label="Writing feed" style="display: grid; gap: var(--space-8); padding-block-end: var(--section-y);">
    {items.length > 0 && <ProjectFilters tags={feedTags(items)} total={items.length} options={used} optionsLabel="Type" noun="item" />}
    {items.length === 0
      ? <div class="project-empty"><p class="project-empty-title">Nothing is published here yet.</p><p class="project-empty-body">New posts and articles are listed on this page as they are published. Until then, the latest is on LinkedIn.</p><div><Button variant="secondary" href={site.socials.linkedin} target="_blank" rel="noopener">Follow on LinkedIn<span class="cory-visually-hidden"> (opens in a new tab)</span></Button></div></div>
      : <div data-cq><ul data-project-list data-cq-balance style="display: grid; gap: var(--grid-gap);">{items.map(i => <li><FeedCard item={i} /></li>)}</ul></div>}
  </section>
  <script>
    import '../components/islands/project-filters.ts';
  </script>
</PageLayout>
