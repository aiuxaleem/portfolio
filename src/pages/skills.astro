---
/* /skills: My Claude Skills (owner request, 10 November 2026, L-63; first built as one page with the market skills in L-61).
   Only the skills the owner built, each shown so a visitor can use it straight away (cards/skill-showcase.astro): what it
   does and gives back, what to say to start it, what it needs, the download and the steps for Claude.ai and Claude Code.
   The skills from others, and the full guide to skills, are on Resources > Claude Skills (/claude-skills). */
import PageLayout from '../layouts/page-layout.astro';
import SkillShowcase from '../components/cards/skill-showcase.astro';
import Button from '../components/ui/button.astro';
import ContactBlock from '../components/profile/contact-block.astro';
import { listedSkills } from '../lib/skills';

const mine = (await listedSkills()).filter(s => s.data.mine);
const downloads = mine.filter(s => s.data.download && !s.data.fixture).length;
const num = (i: number) => String(i + 1).padStart(2, '0');
const stat = 'margin: 0; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-h2); line-height: var(--leading-heading); color: var(--text-strong); font-variant-numeric: tabular-nums;';
const steps = [
  { title: 'Download a skill', body: 'Each one is a small zip with one folder inside. Read its SKILL.md first: it is plain text, and it is everything the skill tells Claude.' },
  { title: 'Add it to Claude', body: 'In Claude.ai, upload the zip under Customize > Skills. In Claude Code, unzip it into ~/.claude/skills. Each skill below shows the exact steps.' },
  { title: 'Say what you want', body: 'Use one of the lines shown with each skill, or your own words. Claude opens the skill when your request matches what it is for.' },
];
---
<PageLayout title="My Claude Skills · AIUXAleem" description="Claude skills Mohammad Abdul Aleem built: a UI/UX audit, a LinkedIn board, a portfolio blog post. What each does, what to say to start it, and how to install it." page="skills" bg="grid" mainStyle="outline: none; overflow: clip;">
  <section class="cory-container" aria-labelledby="skills-title" style="position: relative; display: grid; gap: var(--space-6); padding-block: var(--section-y) var(--space-10);">
    <p class="cory-overline" style="margin: 0px;">Work · My Claude Skills</p>
    <h1 id="skills-title" style="margin: 0px; max-inline-size: 18ch; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-display); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--text-strong); text-wrap: balance;">Skills I built, <span style="background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent;">ready to use</span>.</h1>
    <p style="margin: 0px; max-inline-size: var(--measure-lead); font-size: var(--text-fluid-lead); line-height: var(--leading-relaxed); color: var(--text-muted);">A Claude skill is a folder of instructions that teaches Claude to do one task a set way. These are the ones I built for my own work: audits, boards, posts. Each is free; download it, add it to Claude and say one line.</p>
    <div data-hero-ctas style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;">
      <Button variant="primary" size="lg" href="#mine">See the skills</Button>
      <Button variant="secondary" size="lg" href="/claude-skills">More Claude skills</Button>
    </div>
    <dl class="skills-stats">
      <div><dt>Skills</dt><dd style={stat}>{mine.filter(s => !s.data.fixture).length}</dd></div>
      <div><dt>Free to download</dt><dd style={stat}>{downloads}</dd></div>
      <div><dt>Works in</dt><dd class="skills-stat-words">Claude.ai and Claude Code</dd></div>
    </dl>
  </section>

  <section class="page-section" data-surface="card" aria-labelledby="how-title">
    <div class="cory-container" style="display: grid; gap: var(--space-8);">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">How it works</p><h2 id="how-title" class="page-h2">Three steps, once</h2><p class="project-filter-count">New to skills? Claude Skills explains <a href="/claude-skills#what-title">what a skill is</a> and <a href="/claude-skills#install">how to install one anywhere</a>.</p></div>
      <div data-cq><ol data-cq-balance style="display: grid; gap: var(--grid-gap);">{steps.map((s, i) => <li><div class="tile"><bdi class="tile-num" aria-hidden="true">{num(i)}</bdi><h3>{s.title}</h3><p>{s.body}</p></div></li>)}</ol></div>
    </div>
  </section>

  <section id="mine" class="page-section" aria-labelledby="mine-title">
    <div class="cory-container" style="display: grid; gap: var(--space-8);">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Made by me</p><h2 id="mine-title" class="page-h2">The skills</h2><p class="project-filter-count">Each one encodes how I work: the rules, the checks, the order of steps. Before you add any skill, mine included, read its SKILL.md: a skill gives Claude instructions and code, so treat it like installing software.</p></div>
      {mine.length === 0
        ? <div class="project-empty"><p class="project-empty-title">No skills of mine are listed yet.</p><p class="project-empty-body">Meanwhile, Claude Skills lists the best ones published by others.</p><div><Button variant="secondary" href="/claude-skills">See Claude Skills</Button></div></div>
        : <div data-cq><ul class="skills-show-list">{mine.map((s, i) => <li><SkillShowcase skill={s} id={`skill-${i + 1}`} /></li>)}</ul></div>}
    </div>
  </section>

  <ContactBlock id="contact" overline="Next step" title="Want a skill for your team's design system?" lead="I build skills that make Claude design on your system: your tokens, your components, your checks. Book a 15-minute call, or send what your team needs." topic="project" />
</PageLayout>

<style>
  .skills-stats { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-10); margin: 0; }
  .skills-stats > div { display: grid; gap: var(--space-1); min-inline-size: 0; }
  .skills-stats dt { font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle); }
  .skills-stats dd { margin: 0; }
  .skills-stat-words { font-size: var(--text-body-md); font-weight: var(--weight-semibold); color: var(--text-strong); line-height: var(--leading-snug); max-inline-size: 18ch; }
  .skills-show-list { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--grid-gap); }
</style>
