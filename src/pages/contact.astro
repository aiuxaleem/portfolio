---
/* Contact, the target of "Let's talk" in the header: a one-to-one call and email (the two ways the owner named on
   5 October 2026), what happens after you write, availability, and the contact form (Formspree, owner decision in
   Phase 12). The form is rendered only when a Formspree form id is set in src/content/site/profile.json; until then the
   page offers the links alone, so no visitor meets a form that cannot send. Every form state is on /_states. */
import PageLayout from '../layouts/page-layout.astro';
import ContactBlock from '../components/profile/contact-block.astro';
---
<PageLayout hideHeaderCta title="Contact · AIUXAleem" description="Contact Mohammad Abdul Aleem: book a one-to-one 15-minute call or send an email. Based in Hyderabad, working GCC hours." page="contact" hideCta bg="grid" mainStyle="outline: none; overflow: clip;">
  <ContactBlock level={1} id="contact" overline="Contact" title="Let's talk." lead="Hiring for a senior design role, or building something that has to feel trustworthy? I reply within 48 hours. A 15-minute call is the fastest way to start." />
</PageLayout>
