---
/* The website for hiring managers (docs/SITES.md), its Home: job.aiuxaleem.com. Redesigned as a landing page on
   18 November 2026 (owner request, L-83: "modern, awwwards-worthy … GSAP and/or Three.js"; brand kept, layout new, the
   field a hand-written shader). Everything a recruiter or a hiring manager screens for, in the order they screen: who, what
   level, where and what for (the hero with its four facts over the live field), the idea of the work (two users), the case
   studies (a stack of wide cards), the numbers with their sources, what he brings, the experience in short, the
   certifications, how he works and what he will ask, then the call. No client offer: the band before the call leads to the
   website for clients. Every fact comes from the profile, the site settings and the case studies. */
import PageLayout from '../../layouts/page-layout.astro';
import LandingHero from '../../components/landing/landing-hero.astro';
import LandingStatement from '../../components/landing/landing-statement.astro';
import LandingBand from '../../components/landing/landing-band.astro';
import LandingSection from '../../components/landing/landing-section.astro';
import LandingWork from '../../components/landing/landing-work.astro';
import { caseInsidePictures } from '../../lib/site-stacks';
import LandingFigures from '../../components/landing/landing-figures.astro';
import LandingRows from '../../components/landing/landing-rows.astro';
import Career from '../../components/profile/career.astro';
import Certifications from '../../components/profile/certifications.astro';
import ContactBlock from '../../components/profile/contact-block.astro';
import DoorSwitch from '../../components/sites/door-switch.astro';
import { site, resumeExternal } from '../../content/site';
import { profile } from '../../content/profile';
import { listedCaseStudies } from '../../lib/case-studies';
import { landingFigures, twoUsers } from '../../lib/landing';
import { personLd } from '../../lib/seo';
import { chrome } from '../../i18n/chrome';

const c = chrome.en;
const now = profile.career[0];
/* The case studies: the featured ones first, then the newest of the others, six in all. */
const listed = (await listedCaseStudies()).filter(x => !x.data.fixture);
const featured = listed.filter(x => x.data.featured);
const cases = [...featured, ...listed.filter(x => !featured.includes(x))].slice(0, 6);
/* How I work best, and what I will ask (the owner's career framework of 25 October 2026, his own words made short): the
   conditions he does his best work in, and the questions he brings to a first call. Hiring is a decision on both sides. */
const conditions: [string, string][] = [
  ['Ownership with authority', 'Clear responsibilities and decision rights, the freedom to choose how to deliver an agreed outcome, and accountability for the result.'],
  ['Outcomes, not task counts', 'Success is measured in customer value, product quality and business impact.'],
  ['One table', 'Design, engineering, product and the business work together, not in separate rooms.'],
  ['Responsible AI', 'AI is built for usability, reliability and trust, and for value the business can name.'],
];
const questions = [
  'What does success look like after 90 days, and after a year?',
  'How much decision-making authority does this role have?',
  'How are responsibilities split between product, design, engineering and operations?',
  'How are disagreements resolved, and competing priorities settled?',
  'Why is this role open, and how long has the team been together?',
];
/* Four facts beside the lead: what a hiring manager checks in the first seconds. */
const facts: [string, string][] = [
  ['Now', `${now.role} at ${now.company}, since ${now.start.slice(0, 4)}`],
  ['Experience', '13+ years, from enterprise UX to AI products'],
  ['Open to', 'Design Lead or Principal roles, KSA, the UAE or remote'],
  ['Based in', `${site.location}, on GCC hours. ${site.availability.label}`],
];
---
<PageLayout title={`${profile.headline} · Aleem, for hiring managers`} description={`For recruiters and hiring managers: ${site.name}, ${profile.headline}. Experience, case studies, certifications and the resume in one place.`} page="hiring" hideCta bg="grid" mainStyle="outline: none; overflow: clip;" jsonLd={[personLd()]}>
  <LandingHero id="hiring" overline="For hiring managers" status={site.availability.label} title={`A ${profile.headline} for your team.`} accent="AI Product Designer" lead={`I'm ${site.name}. ${profile.positioning}`} primary={{ label: c.call, href: site.calendarUrl, newTab: true }} secondary={{ label: resumeExternal ? 'View resume' : 'Download resume', href: site.resumeUrl, newTab: resumeExternal, download: !resumeExternal }}>
    <dl slot="aside" class="hiring-facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
  </LandingHero>

  <LandingStatement id="hiring-idea" overline="The idea behind the work" text={twoUsers.title} accent={twoUsers.accent} body={twoUsers.body} />

  <LandingBand items={profile.expertise.map(e => e.title)} />

  {cases.length > 0 && (
    <LandingSection id="hiring-work" art="caseStudy" pictures={caseInsidePictures(cases)} index="01" overline="Selected work" title="Case studies" lead="Each one gives the problem, the constraints, the decisions with their trade-offs, and what shipped.">
      <LandingWork entries={cases} />
      <a data-link class="post-back hiring-all" href="/case-studies"><span>All case studies</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
    </LandingSection>
  )}

  <LandingSection id="hiring-numbers" art="measured" index="02" overline="In numbers" title="What the work measured" lead="Each figure is from a case study, where the method and the before and after are shown." surface="card">
    <LandingFigures figures={landingFigures} />
  </LandingSection>

  <LandingSection id="hiring-bring" index="03" overline="Expertise" title="What I bring to a product team" split art="expertise">
    <LandingRows rows={profile.expertise.map(e => ({ title: e.title, body: e.body }))} />
  </LandingSection>

  <LandingSection id="hiring-career" art="careerSpan" index="04" overline="Work experience" title="Enterprise UX to AI product design" lead="Newest first. Each role, with what it shipped, is on the Experience page." surface="card">
    <Career highlights={false} />
    <a data-link class="post-back hiring-all" href="/experience"><span>The full experience, with what each role shipped</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
  </LandingSection>

  <LandingSection id="hiring-certs" art="certs" index="05" overline="Learning" title="Certifications" lead="Verified certificates and the ones in progress. The full list is on the Experience page.">
    <Certifications only={['in-progress', 'verified']} />
  </LandingSection>

  <LandingSection id="hiring-how" art="conversation" index="06" overline="How I work" title="Where I do my best work, and what I'll ask you" lead="Hiring is a decision on both sides. These are the conditions I do my best work in, and the questions I bring to a first call." surface="card">
    <div class="hiring-how">
      <LandingRows rows={conditions.map(([t, b]) => ({ title: t, body: b }))} />
      <div class="project-cta hiring-ask" role="region" aria-labelledby="hiring-ask-title">
        <p class="cory-overline" style="margin: 0; color: var(--on-ink-link);">In a first call</p>
        <h3 id="hiring-ask-title" class="hiring-ask-title">What I will ask you</h3>
        <ol class="hiring-ask-list">{questions.map((q, i) => <li><bdi aria-hidden="true">{String(i + 1).padStart(2, '0')}</bdi><span>{q}</span></li>)}</ol>
      </div>
    </div>
  </LandingSection>

  <DoorSwitch to="clients" id="hiring-switch" />

  <ContactBlock id="contact" overline="Next step" title="Hiring for a design lead? Let's talk." lead={"Book a 15-⁠minute call, or send the role and the team. I reply within 48 hours."} topic="role" />
</PageLayout>

<style>
  /* The four facts beside the lead, two by two: a rule above each, the label small, the fact strong. */
  .hiring-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); gap: var(--space-5) var(--space-8); margin: 0; }
  .hiring-facts > div { display: grid; gap: var(--space-1); align-content: start; padding-block-start: var(--space-3); border-block-start: 1px solid var(--border-default); min-inline-size: 0; }
  .hiring-facts dt { font-family: var(--font-mono); font-size: var(--text-mono-sm); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-muted); }
  .hiring-facts dd { margin: 0; font-size: var(--text-body-md); font-weight: var(--weight-semibold); line-height: var(--leading-heading); color: var(--text-strong); text-wrap: balance; overflow-wrap: anywhere; }
  .hiring-all { justify-self: start; }
  /* How I work: the conditions beside the questions where there is room, the questions first below that. */
  .hiring-how { display: grid; gap: var(--space-10); align-items: start; }
  @media (min-width: 1024px) { .hiring-how { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); } .hiring-ask { position: sticky; inset-block-start: calc(var(--header-height) + var(--space-10)); } }
  @media (max-width: 1023.98px) { .hiring-ask { order: -1; } }
  .hiring-ask { display: grid; gap: var(--space-4); padding: var(--space-8); box-shadow: var(--shadow-md); }
  .hiring-ask-title { margin: 0; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-h3); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); color: var(--on-ink-strong); }
  .hiring-ask-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .hiring-ask-list li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-4); border-block-start: 1px solid var(--on-ink-border); color: var(--on-ink-body); line-height: var(--leading-relaxed); overflow-wrap: anywhere; }
  .hiring-ask-list bdi { font-family: var(--font-mono); font-size: var(--text-mono); color: var(--on-ink-link); padding-block-start: 2px; }
</style>
