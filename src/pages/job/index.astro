---
/* The website for hiring teams (docs/SITES.md), its Home: job.aiuxaleem.com. Everything a recruiter or a hiring manager
   screens for, in the order they screen: who, what level, where and what for (the hero, its four facts and the stack
   of featured case studies, as on the main site's Home), more work, what he brings, the experience in short, the certifications, then the call. No client offer: the
   band before the call leads to the website for clients. Every fact comes from the profile and site settings. */
import PageLayout from '../../layouts/page-layout.astro';
import SiteHero from '../../components/sites/site-hero.astro';
import HeroStack from '../../components/sites/hero-stack.astro';
import CaseCard from '../../components/cards/case-card.astro';
import Career from '../../components/profile/career.astro';
import Certifications from '../../components/profile/certifications.astro';
import ContactBlock from '../../components/profile/contact-block.astro';
import DoorSwitch from '../../components/sites/door-switch.astro';
import { site, resumeExternal } from '../../content/site';
import { profile, period } from '../../content/profile';
import { listedCaseStudies } from '../../lib/case-studies';
import { caseCard } from '../../lib/site-stacks';
import { personLd } from '../../lib/seo';
import { chrome } from '../../i18n/chrome';

const c = chrome.en;
const now = profile.career[0];
/* The stack holds the featured case studies; the section after the first screen, the newest of the others. */
const listed = (await listedCaseStudies()).filter(x => !x.data.fixture);
const featured = listed.filter(x => x.data.featured).slice(0, 3);
const cases = listed.filter(x => !featured.includes(x)).slice(0, 3);
/* Four facts under the buttons, as on the main site's Home: what a hiring manager checks in the first seconds. */
const facts: [string, string][] = [
  ['Now', `${now.role}, ${now.company} (${period(now)})`],
  ['Experience', '13+ years, from enterprise UX to AI products'],
  ['Open to', 'Lead and Principal roles in KSA and the UAE, on-site or remote'],
  ['Based in', `${site.location}, on GCC hours. ${site.availability.label}`],
];
---
<PageLayout title={`${profile.headline} · For hiring teams · AIUXAleem`} description={`For recruiters and hiring managers: ${site.name}, ${profile.headline}. Experience, case studies, certifications and the resume in one place.`} page="hiring" hideCta bg="grid" mainStyle="outline: none; overflow: clip;" jsonLd={[personLd()]}>
  <SiteHero id="hiring" overline="For hiring teams" title={`A ${profile.headline} for your team.`} accent="AI Product Designer" lead={`I'm ${site.name}. ${profile.positioning} Thirteen-plus years in enterprise UX, fintech and AI products, now leading AI product design at ${now.company}.`} primary={{ label: c.call, href: site.calendarUrl, newTab: true }} secondary={{ label: resumeExternal ? 'View resume' : 'Download resume', href: site.resumeUrl, newTab: resumeExternal, download: !resumeExternal }}>
    <div slot="after" data-cq><dl data-cq-grid class="hiring-facts">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl></div>
    {featured.length > 0 && <HeroStack slot="art" id="hiring-stack" label="Selected work" noun="case study" cards={featured.map(caseCard)} />}
  </SiteHero>

  {cases.length > 0 && (
    <section class="page-section" data-surface="card" aria-labelledby="hiring-work-title">
      <div class="cory-container">
        <div class="page-section-head"><p class="cory-overline" style="margin: 0;">The work</p><h2 id="hiring-work-title" class="page-h2">{featured.length > 0 ? 'More case studies' : 'Case studies to start with'}</h2><p class="project-filter-count" style="max-inline-size: var(--measure-lead);">Each one gives the problem, the constraints, the decisions with their trade-offs, and what shipped.</p></div>
        <div data-cq><ul data-cq-balance style="display: grid; gap: var(--grid-gap);">{cases.map(entry => <li><CaseCard entry={entry} level={3} /></li>)}</ul></div>
        <a data-link class="post-back" href="/case-studies"><span>All case studies</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
      </div>
    </section>
  )}

  <section class="page-section" aria-labelledby="hiring-bring-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Expertise</p><h2 id="hiring-bring-title" class="page-h2">What I bring to a product team</h2></div>
      <div data-cq><ul data-cq-balance style="display: grid; gap: var(--grid-gap);">{profile.expertise.map(e => <li><div class="tile"><h3>{e.title}</h3><p>{e.body}</p></div></li>)}</ul></div>
    </div>
  </section>

  <section class="page-section" data-surface="card" aria-labelledby="hiring-career-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Work experience</p><h2 id="hiring-career-title" class="page-h2">Enterprise UX to AI product design</h2><p class="project-filter-count">Newest first. Each role, with what it shipped, is on the Experience page.</p></div>
      <Career highlights={false} />
      <a data-link class="post-back" href="/experience"><span>The full experience, with what each role shipped</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg></a>
    </div>
  </section>

  <section class="page-section" aria-labelledby="hiring-certs-title">
    <div class="cory-container">
      <div class="page-section-head"><p class="cory-overline" style="margin: 0;">Learning</p><h2 id="hiring-certs-title" class="page-h2">Certifications</h2><p class="project-filter-count">Verified certificates and the ones in progress. The full list is on the Experience page.</p></div>
      <Certifications only={['in-progress', 'verified']} />
    </div>
  </section>

  <DoorSwitch to="clients" id="hiring-switch" />

  <ContactBlock id="contact" overline="Next step" title="Hiring for a design lead? Let's talk." lead="Book a 15-minute call, or send the role and the team. I reply within 48 hours." topic="role" />
</PageLayout>

<style>
  /* The four facts: the main site's Home hero row (a rule above each, the label small, the fact strong). */
  .hiring-facts { display: grid; gap: var(--space-4) var(--space-6); margin: var(--space-2) 0 0; }
  .hiring-facts > div { display: grid; gap: var(--space-1); align-content: start; padding-block-start: var(--space-3); border-block-start: 1px solid var(--border-default); min-inline-size: 0; }
  .hiring-facts dt { font-size: var(--text-caption); font-weight: var(--weight-semibold); color: var(--text-subtle); }
  .hiring-facts dd { margin: 0; font-size: var(--text-body-md); font-weight: var(--weight-semibold); line-height: var(--leading-heading); color: var(--text-strong); text-wrap: balance; overflow-wrap: anywhere; }
</style>
