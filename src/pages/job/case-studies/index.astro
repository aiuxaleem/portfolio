---
/* Case studies on the website for hiring managers (docs/SITES.md): a first screen with the newest cases fanned beside the words,
   then every case as a bento. The call is about a role; the resume sits beside it. */
import PageLayout from '../../../layouts/page-layout.astro';
import SiteHero from '../../../components/sites/site-hero.astro';
import HeroStack from '../../../components/sites/hero-stack.astro';
import { moreCases } from '../../../lib/site-stacks';
import CaseGrid from '../../../components/sites/case-grid.astro';
import { site, resumeExternal } from '../../../content/site';
import { chrome } from '../../../i18n/chrome';
const c = chrome.en;
const stack = await moreCases();
---
<PageLayout title="Case studies · AIUXAleem, for hiring managers" description="Case studies by Mohammad Abdul Aleem, Lead AI Product Designer: the problem, the constraints, the decisions with their trade-offs and what shipped." page="case-studies" bg="grid" mainStyle="outline: none; overflow: clip;">
  <SiteHero id="job-cases" overline="The work" title="Case studies, with the decisions behind them." accent="decisions" lead="Each one gives the problem, the constraints, the decisions with their trade-offs, and what shipped: the way I work, applied to a different kind of trust problem each time." primary={{ label: c.call, href: site.calendarUrl, newTab: true }} secondary={{ label: resumeExternal ? 'View resume' : 'Download resume', href: site.resumeUrl, newTab: resumeExternal }}>
    <HeroStack slot="art" id="cases-stack" label="Case studies" noun="case study" cards={stack} />
  </SiteHero>
  <CaseGrid />
</PageLayout>
