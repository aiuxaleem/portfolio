---
/* /case-studies: every published case study, as whole-card links (the project card's recipe) in a bento: the newest case
   wide, with its picture beside its words, then the rest two to a row. */
import HeroStack from '../../components/sites/hero-stack.astro';
import { moreCases } from '../../lib/site-stacks';
import PageLayout from '../../layouts/page-layout.astro';
import Button from '../../components/ui/button.astro';
import CaseCard from '../../components/cards/case-card.astro';
import { listedCaseStudies } from '../../lib/case-studies';
import { site, resumeAttrs, resumeExternal } from '../../content/site';

const cases = await listedCaseStudies();
/* The heading's number is the count of listed case studies, in words up to ten. */
const shown = cases.filter(c => !c.data.fixture).length;
const word = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'][shown] ?? String(shown);
const stack = await moreCases();
---
<PageLayout title="Case studies · AIUXAleem" description="Case studies by Mohammad Abdul Aleem: the problem, the process, the decisions and what changed, for design systems and AI product work." page="case-studies" bg="grid" mainStyle="outline: none; overflow: clip;">
  <section id="intro" class="cory-container hero-split" aria-labelledby="cases-title" style="position: relative; display: grid; gap: var(--space-6); padding-block: var(--section-y) var(--space-10);">
    <div class="hero-split-words">
      <p class="cory-overline" style="margin: 0px;">My recent work · Case studies</p>
      <h1 id="cases-title" style="margin: 0px; max-inline-size: 16ch; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-display); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--text-strong);">{word} {shown === 1 ? 'product' : 'products'}, one <span style="background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent;">method</span>.</h1>
      <p style="margin: 0px; max-inline-size: var(--measure-lead); font-size: var(--text-fluid-lead); line-height: var(--leading-relaxed); color: var(--text-muted);">Understand the workflow, redesign it, build it with AI, validate it with people. Each case below is that method applied to a different kind of trust problem.</p>
      <div data-hero-ctas style="display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;">
        <Button variant="primary" size="lg" href={site.calendarUrl} target="_blank" rel="noopener">Book a 15-min call<span class="cory-visually-hidden"> (opens in a new tab)</span></Button>
        <Button variant="secondary" size="lg" href={site.resumeUrl} {...resumeAttrs}>{resumeExternal ? 'View resume' : 'Download resume'}{resumeExternal && <span class="cory-visually-hidden"> (opens in a new tab)</span>}</Button>
      </div>
    </div>
    <HeroStack id="cases-stack" label="Case studies" noun="case study" cards={stack} />
  </section>
  <section id="cases" class="cory-container" aria-label="Case study list" style="padding-block-end: var(--section-y);">
    {cases.length === 0
      ? <div class="project-empty"><p class="project-empty-title">No case studies are published yet.</p><p class="project-empty-body">The projects page lists current work.</p><div><Button variant="secondary" href="/work">See the projects</Button></div></div>
      : <ul class="case-bento">
          {cases.map((entry, i) => <li class={i === 0 ? 'case-bento-lead' : undefined}><CaseCard entry={entry} first={i === 0} wide={i === 0} /></li>)}
        </ul>}
  </section>
</PageLayout>

<style>
  /* Bento: one column on a phone; from 768px two columns, the lead card across both. */
  .case-bento { display: grid; gap: var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .case-bento > li { display: grid; min-inline-size: 0; }
  @media (min-width: 768px) { .case-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } .case-bento-lead { grid-column: 1 / -1; } }
</style>
