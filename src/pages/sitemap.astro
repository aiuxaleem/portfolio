---
/* /sitemap: every page of the site on one page, in the header's groups (My recent work, My resources, Resources, About),
   with each project, case study and blog post listed under its section. Linked from the foot of every page. The XML
   sitemap for search engines is /sitemap-index.xml. */
import PageLayout from '../layouts/page-layout.astro';
import { site, isGroup } from '../content/site';
import { listedProjects } from '../lib/projects';
import { listedCaseStudies } from '../lib/case-studies';
import { listedPosts, postUrl } from '../lib/posts';

const [projects, cases, posts] = await Promise.all([listedProjects(), listedCaseStudies(), listedPosts()]);
/* The pages under each header page: the entries it lists. */
const under: Record<string, { label: string; href: string }[]> = {
  '/work': projects.map(p => ({ label: p.data.title, href: `/work/${p.id}` })),
  '/case-studies': cases.map(c => ({ label: c.data.title, href: `/case-studies/${c.id}` })),
  '/blog': posts.map(p => ({ label: p.data.title, href: postUrl(p) })),
};
type Link = { label: string; href: string; blurb?: string };
const groups: { title: string; links: Link[] }[] = [];
const loose: Link[] = [];
for (const n of site.nav) {
  if (isGroup(n)) groups.push({ title: n.label, links: n.children });
  else loose.push(n);
}
const more: Link[] = [
  ...loose,
  { label: 'Services', href: '/services' },
  { label: 'Now', href: '/now', blurb: 'What I am working on and learning this month' },
  { label: 'Resume', href: '/resume' },
  { label: "Let's talk", href: '/contact' },
  { label: 'الصفحة الرئيسية بالعربية', href: '/ar' },
];
const feeds: Link[] = [{ label: 'Blog feed (RSS)', href: '/rss.xml' }, { label: 'Sitemap for search engines (XML)', href: '/sitemap-index.xml' }];
const arrow = 'M5 12h14M12 5l7 7-7 7';
---
<PageLayout title="Sitemap · AIUXAleem" description="Every page on aiuxaleem.com in one place: projects, case studies, blog posts, LinkedIn posts and articles, videos, the UX Glossary, AI Tools and contact." page="sitemap" bg="grid" mainStyle="outline: none; overflow: clip;">
  <section class="cory-container" aria-labelledby="sitemap-title" style="display: grid; gap: var(--space-6); padding-block: var(--section-y) var(--space-10);">
    <p class="cory-overline" style="margin: 0px;">Sitemap</p>
    <h1 id="sitemap-title" style="margin: 0px; max-inline-size: 18ch; font-family: var(--font-display); font-weight: var(--weight-extrabold); font-size: var(--text-fluid-display); line-height: var(--leading-snug); letter-spacing: var(--tracking-tighter); color: var(--text-strong);">Every page, in one place.</h1>
    <p style="margin: 0px; max-inline-size: var(--measure-lead); font-size: var(--text-fluid-lead); line-height: var(--leading-relaxed); color: var(--text-muted);">The site in the same groups as the menu at the top, with every project, case study and blog post under its page.</p>
  </section>

  <div class="cory-container sitemap-grid" style="padding-block-end: var(--section-y);">
    {groups.map(g => (
      <section class="sitemap-group" aria-labelledby={`sm-${g.title.replace(/\W+/g, '-').toLowerCase()}`}>
        <h2 id={`sm-${g.title.replace(/\W+/g, '-').toLowerCase()}`} class="sitemap-h2">{g.title}</h2>
        <ul class="sitemap-list">
          {g.links.map(l => (
            <li>
              <a class="sitemap-link" href={l.href}><span>{l.label}</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}></path></svg></a>
              {l.blurb && <p class="sitemap-blurb">{l.blurb}</p>}
              {(under[l.href]?.length ?? 0) > 0 && <ul class="sitemap-sub" aria-label={`In ${l.label}`}>{under[l.href].map(s => <li><a data-link href={s.href}>{s.label}</a></li>)}</ul>}
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section class="sitemap-group" aria-labelledby="sm-more">
      <h2 id="sm-more" class="sitemap-h2">About and more</h2>
      <ul class="sitemap-list">
        {more.map(l => <li><a class="sitemap-link" href={l.href} lang={l.href === '/ar' ? 'ar' : undefined} dir={l.href === '/ar' ? 'rtl' : undefined}><span>{l.label}</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}></path></svg></a>{l.blurb && <p class="sitemap-blurb">{l.blurb}</p>}</li>)}
      </ul>
      <h2 class="sitemap-h2" id="sm-feeds" style="margin-block-start: var(--space-6);">Feeds</h2>
      <ul class="sitemap-list" aria-labelledby="sm-feeds">
        {feeds.map(l => <li><a class="sitemap-link" href={l.href}><span>{l.label}</span><svg data-dir-icon width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}></path></svg></a></li>)}
      </ul>
    </section>
  </div>
</PageLayout>

<style>
  /* Columns, not a grid: the groups differ a lot in length, so each column fills down without gaps. */
  .sitemap-grid { columns: 3 300px; column-gap: var(--grid-gap); }
  .sitemap-group { break-inside: avoid; margin-block-end: var(--grid-gap); display: grid; gap: var(--space-4); padding: var(--space-6); border-radius: var(--radius-xl); background: var(--surface-card); border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); min-inline-size: 0; }
  .sitemap-h2 { margin: 0; font-size: var(--text-overline); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-overline); text-transform: uppercase; color: var(--text-subtle); }
  .sitemap-list { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .sitemap-list > li { display: grid; gap: var(--space-1); min-inline-size: 0; }
  .sitemap-link { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-block-size: var(--tap-target); font-family: var(--font-display); font-size: var(--text-h4); font-weight: var(--weight-bold); color: var(--text-strong); text-decoration: none; overflow-wrap: anywhere; }
  .sitemap-link > span { min-inline-size: 0; }
  .sitemap-link svg { flex: none; color: var(--text-link); }
  @media (hover: hover) { .sitemap-link:hover { color: var(--text-link); } }
  .sitemap-link:focus-visible { color: var(--text-link); }
  .sitemap-blurb { margin: 0; font-size: var(--text-body-sm); color: var(--text-muted); }
  .sitemap-sub { display: grid; gap: 0; margin: var(--space-1) 0 var(--space-3); padding: 0; padding-inline-start: var(--space-4); list-style: none; border-inline-start: 1px solid var(--border-subtle); }
  .sitemap-sub a { display: flex; align-items: center; min-block-size: var(--tap-target); font-size: var(--text-body-sm); overflow-wrap: anywhere; }
</style>
